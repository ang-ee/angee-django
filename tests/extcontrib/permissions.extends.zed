// Additive REBAC extension — contributes to a definition owned by another addon.
// @rebac_package: extcontrib
// @rebac_schema_revision: 4

// `scopedemo/doc` is owned by `tests.scopedemo`; this fragment contributes a
// `reviewer` relation and unions it into the `read` arm without editing the
// owner's permissions.zed. django-zed-rebac never reads this file — Angee's
// build-time merge folds it into the owning package's effective schema.
definition scopedemo/doc {
    relation reviewer: auth/user

    permission read = reviewer
}

// The record owns its read gate; source evidence never grants conversation read.
definition messaging/thread {
    relation chatter_record: chatterdemo/doc // rebac:field={"path":"attachments__chatterdemo_chatterdoc","filters":{"attachments__role":"chatter"}}

    permission read = chatter_record->read
}

// Account actions follow the bound team's live roster. Preview authority stays
// with the target's seat paths; this constant deliberately contributes no arm.
// `write` reaches only the name fields: IAM's field gates keep identity,
// credential and authority columns with administrators.
definition auth/user {
    relation manager: extcontrib/role // rebac:const=manager

    permission create = manager->effective_member
    permission read = manager->effective_member
    permission write = manager->effective_member
    permission read__last_login = manager->effective_member
    permission issue_password = manager->effective_member
    permission reset_password = manager->effective_member
    permission set_active = manager->effective_member
    permission rename = manager->effective_member
}

// The role is elevated: its holders' accounts are protected from account verbs,
// including other managers'.
definition iam/protected {
    relation manager: extcontrib/role // rebac:const=manager

    permission member = manager->effective_member
}
