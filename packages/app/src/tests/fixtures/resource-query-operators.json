{
  "sdl": "schema {\n  query: QueryScalarRoot\n}\n\ntype QueryScalarRow {\n  id: ID!\n  name: String!\n  count: Int!\n  ratio: Float!\n  amount: Decimal!\n  active: Boolean!\n  date: Date!\n  timestamp: DateTime!\n  time: Time!\n  uuid: UUID!\n  payload: JSON!\n  state: QueryState!\n  choice: QueryState!\n}\n\n\"\"\"Decimal (fixed-point)\"\"\"\nscalar Decimal\n\n\"\"\"Date (isoformat)\"\"\"\nscalar Date\n\n\"\"\"Date with time (isoformat)\"\"\"\nscalar DateTime\n\n\"\"\"Time (isoformat)\"\"\"\nscalar Time\n\nscalar UUID\n\n\"\"\"\nThe `JSON` scalar type represents JSON values as specified by [ECMA-404](https://ecma-international.org/wp-content/uploads/ECMA-404_2nd_edition_december_2017.pdf).\n\"\"\"\nscalar JSON @specifiedBy(url: \"https://ecma-international.org/wp-content/uploads/ECMA-404_2nd_edition_december_2017.pdf\")\n\nenum QueryState {\n  OPEN\n  CLOSED\n}\n\ninput query_scalars_bool_exp {\n  id: ID_comparison_exp\n  name: String_comparison_exp\n  count: Int_comparison_exp\n  ratio: Float_comparison_exp\n  amount: Decimal_comparison_exp\n  active: Boolean_comparison_exp\n  date: Date_comparison_exp\n  timestamp: DateTime_comparison_exp\n  time: Time_comparison_exp\n  uuid: String_comparison_exp\n  payload: JSON_comparison_exp\n  state: QueryStateComparison\n  choice: String_comparison_exp\n  _and: [query_scalars_bool_exp!]\n  _or: [query_scalars_bool_exp!]\n  _not: query_scalars_bool_exp\n}\n\ninput ID_comparison_exp {\n  _eq: String\n  _neq: String\n  _in: [String!]\n  _nin: [String!]\n  _is_null: Boolean\n}\n\ninput String_comparison_exp {\n  _eq: String\n  _neq: String\n  _gt: String\n  _gte: String\n  _lt: String\n  _lte: String\n  _in: [String!]\n  _nin: [String!]\n  _like: String\n  _nlike: String\n  _ilike: String\n  _nilike: String\n  _iregex: String\n  _similar: String\n  _nsimilar: String\n  _is_null: Boolean\n}\n\ninput Int_comparison_exp {\n  _eq: Int\n  _neq: Int\n  _gt: Int\n  _gte: Int\n  _lt: Int\n  _lte: Int\n  _in: [Int!]\n  _nin: [Int!]\n  _is_null: Boolean\n}\n\ninput Float_comparison_exp {\n  _eq: Float\n  _neq: Float\n  _gt: Float\n  _gte: Float\n  _lt: Float\n  _lte: Float\n  _in: [Float!]\n  _nin: [Float!]\n  _is_null: Boolean\n}\n\ninput Decimal_comparison_exp {\n  _eq: Decimal\n  _neq: Decimal\n  _gt: Decimal\n  _gte: Decimal\n  _lt: Decimal\n  _lte: Decimal\n  _in: [Decimal!]\n  _nin: [Decimal!]\n  _is_null: Boolean\n}\n\ninput Boolean_comparison_exp {\n  _eq: Boolean\n  _neq: Boolean\n  _is_null: Boolean\n}\n\ninput Date_comparison_exp {\n  _eq: Date\n  _neq: Date\n  _gt: Date\n  _gte: Date\n  _lt: Date\n  _lte: Date\n  _in: [Date!]\n  _nin: [Date!]\n  _is_null: Boolean\n}\n\ninput DateTime_comparison_exp {\n  _eq: DateTime\n  _neq: DateTime\n  _gt: DateTime\n  _gte: DateTime\n  _lt: DateTime\n  _lte: DateTime\n  _in: [DateTime!]\n  _nin: [DateTime!]\n  _is_null: Boolean\n}\n\ninput Time_comparison_exp {\n  _eq: Time\n  _neq: Time\n  _gt: Time\n  _gte: Time\n  _lt: Time\n  _lte: Time\n  _in: [Time!]\n  _nin: [Time!]\n  _is_null: Boolean\n}\n\ninput JSON_comparison_exp {\n  _eq: JSON\n  _neq: JSON\n  _contains: JSON\n  _is_null: Boolean\n}\n\ninput QueryStateComparison {\n  _eq: QueryState\n  _in: [QueryState!]\n  _is_null: Boolean\n}\n\ntype QueryScalarRoot {\n  ready: Boolean!\n}",
