{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": false,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "typeRoots": ["./node_modules/@types", "../node_modules/.pnpm/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src", "config"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
