{
  "name": "@angee/app",
  "version": "0.0.0",
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/ang-ee/angee-react.git",
    "directory": "app"
  },
  "homepage": "https://docs.angee.ai/react/",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "angee-web-codegen": "./bin/angee-web-codegen.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./create-app": {
      "types": "./src/create-app.tsx",
      "import": "./src/create-app.tsx"
    },
    "./define-addon": {
      "types": "./src/define-addon.ts",
      "import": "./src/define-addon.ts"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "import": "./src/auth/index.ts"
    },
    "./testing": {
      "types": "./src/testing.tsx",
      "import": "./src/testing.tsx"
    },
    "./providers/i18n": {
      "types": "./src/providers/i18n.ts",
      "import": "./src/providers/i18n.ts"
    },
    "./providers/auth": {
      "types": "./src/providers/auth.tsx",
      "import": "./src/providers/auth.tsx"
    },
    "./vite": {
      "types": "./config/vite.ts",
      "import": "./config/vite.ts"
    },
    "./vitest": {
      "types": "./config/vitest.ts",
      "import": "./config/vitest.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "angee-web-codegen": "./dist/bin/angee-web-codegen.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./create-app": {
        "types": "./dist/create-app.d.ts",
        "default": "./dist/create-app.js"
      },
      "./define-addon": {
        "types": "./dist/define-addon.d.ts",
        "default": "./dist/define-addon.js"
      },
      "./auth": {
        "types": "./dist/auth/index.d.ts",
        "default": "./dist/auth/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "./providers/i18n": {
        "types": "./dist/providers/i18n.d.ts",
        "default": "./dist/providers/i18n.js"
      },
      "./providers/auth": {
        "types": "./dist/providers/auth.d.ts",
        "default": "./dist/providers/auth.js"
      },
      "./vite": {
        "types": "./dist/config/vite.d.ts",
        "default": "./dist/config/vite.js"
      },
      "./vitest": {
        "types": "./dist/config/vitest.d.ts",
        "default": "./dist/config/vitest.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R dist/src/. dist && rm -rf dist/src && mkdir -p dist/bin && cp bin/angee-web-codegen.mjs dist/bin/angee-web-codegen.mjs"
  },
  "dependencies": {
    "@angee/logo-react": "^0.2.1",
    "@angee/refine": "workspace:*",
    "@angee/metadata": "workspace:*",
    "@angee/ui": "workspace:*",
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/client-preset": "^6.0.1",
    "@refinedev/core": "^5.0.12",
    "graphql": "^16.14.0",
    "i18next": "^26.3.2",
    "nuqs": "^2.5.0"
  },
  "peerDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-router": "^1",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/vite": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@refinedev/react-hook-form": "^5.0.4",
    "@refinedev/react-table": "^6.0.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.10.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
