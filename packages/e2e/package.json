{
  "name": "@angee/e2e",
  "version": "0.0.0",
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/ang-ee/angee-react.git",
    "directory": "e2e"
  },
  "homepage": "https://docs.angee.ai/react/",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
