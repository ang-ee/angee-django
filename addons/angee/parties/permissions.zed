// Authorization schema for the parties addon.
// @rebac_package: parties
// @rebac_package_version: 0.1.0
// @rebac_schema_revision: 8

// A party and its related rows (handles, links, addresses, relationships) are
// each owned by the user that created them, with platform admins reaching every
// row through the const-backed `angee/role:admin` membership (no per-row tuple).
// Each owns its own created_by rather than reaching through the party, so a
// handle synced for an unknown sender (party still null) stays readable.

// Record owners may contribute identity read arms. Private fields and private
// uses of a party require read_private, which retains per-row grants. An
// explicit `reader` grant on an MTI child also reaches each parent that accepts
// the relation and subject through the resources grant loader
// (`addons/angee/resources/grants.py`). Related rows keep their own read rules.
// Lossless contact data and handle counts are private. created_by, updated_by
// and their labels remain readable: attribution belongs to identity.

definition parties/party {
    relation owner: auth/user // rebac:field=created_by
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = owner + editor + reader + admin->member
    permission read_private = owner + editor + reader + admin->member
    permission read__notes = read_private
    permission read__first_met_note = read_private
    permission read__raw_vcard = read_private
    permission read__extensions = read_private
    permission read__handle_count = read_private
    permission write  = owner + editor + admin->member
    permission delete = owner + admin->member
}

// Person and Organization are multi-table-inheritance children of parties/party.
// Each owns its own created_by so its child row authorizes independently of the
// parent row.

definition parties/person {
    relation owner: auth/user // rebac:field=created_by
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = owner + editor + reader + admin->member
    permission read_private = owner + editor + reader + admin->member
    // Field gates are per resource definition, including inherited columns.
    permission read__notes = read_private
    permission read__first_met_note = read_private
    permission read__raw_vcard = read_private
    permission read__extensions = read_private
    permission read__handle_count = read_private
    permission read__birthday = read_private
    permission read__anniversary = read_private
    permission read__nickname = read_private
    permission write  = owner + editor + admin->member
    permission delete = owner + admin->member
}

definition parties/organization {
    relation owner: auth/user // rebac:field=created_by
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = owner + editor + reader + admin->member
    permission write  = owner + editor + admin->member
    permission delete = owner + admin->member
}

definition parties/handle {
    relation owner: auth/user // rebac:field=created_by
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = owner + editor + reader + admin->member
    permission write  = owner + editor + admin->member
    permission delete = owner + admin->member
}

definition parties/party_handle {
    relation owner: auth/user // rebac:field=created_by
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = owner + editor + reader + admin->member
    permission write  = owner + editor + admin->member
    permission delete = owner + admin->member
}

// One source's claim under a party-handle link. It is read with its link, and
// whoever may change the link may change the claims beneath it.
definition parties/party_handle_claim {
    relation link: parties/party_handle // rebac:field=link
    relation owner: auth/user // rebac:field=created_by
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = link->read
    permission write  = owner + link->write + admin->member
    permission delete = owner + link->write + admin->member
}

// A keep-separate decision follows the same per-row ownership shape as the
// identity claims it governs. Pair canonicalization is a database/model fact;
// this definition owns only who may read, write, or delete the decision row.
definition parties/merge_veto {
    relation owner: auth/user // rebac:field=created_by
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = owner + editor + reader + admin->member
    permission write  = owner + editor + admin->member
    permission delete = owner + admin->member
}

definition parties/address {
    relation owner: auth/user // rebac:field=created_by
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = owner + editor + reader + admin->member
    permission write  = owner + editor + admin->member
    permission delete = owner + admin->member
}

definition parties/folder {
    relation owner: auth/user // rebac:field=created_by
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = owner + editor + reader + admin->member
    permission write  = owner + editor + admin->member
    permission delete = owner + admin->member
}

// Circles and relationships are the human-owned organising surfaces. They follow
// the same per-row ownership shape as the rows they organise; a circle NEVER
// gates party visibility (organising ≠ authorization — REBAC reader grants stay
// the one read owner).

definition parties/circle {
    relation owner: auth/user // rebac:field=created_by
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = owner + editor + reader + admin->member
    permission write  = owner + editor + admin->member
    permission delete = owner + admin->member
}

definition parties/circle_member {
    relation owner: auth/user // rebac:field=created_by
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = owner + editor + reader + admin->member
    permission write  = owner + editor + admin->member
    permission delete = owner + admin->member
}

// The relationship vocabulary is catalogue data every signed-in user picks
// from; user-added kinds stay editable by their creator, seeded rows
// (created_by null) only by platform admins.
definition parties/relationship_kind {
    relation owner: auth/user // rebac:field=created_by
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = authenticated
    permission write  = owner + admin->member
    permission delete = owner + admin->member
}

definition parties/relationship {
    relation owner: auth/user // rebac:field=created_by
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = owner + editor + reader + admin->member
    permission write  = owner + editor + admin->member
    permission delete = owner + admin->member
}

// A Directory is a multi-table-inheritance child of integrate/integration (a
// contacts-sync bridge), so its access derives from the parent integration the
// way integrate_vcs/vcs_bridge does; platform admins reach all.
definition parties/directory {
    relation integration: integrate/integration // rebac:field=integration_ptr
    relation admin: angee/role // rebac:const=admin

    permission create = admin->member
    permission read   = integration->read + admin->member
    permission write  = integration->write + admin->member
    permission delete = integration->write + admin->member
}
