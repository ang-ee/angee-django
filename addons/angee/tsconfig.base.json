{
  "compilerOptions": {
    // Base-addon fragments typecheck against the stack's composed generated
    // documents. A composed stack is authoritative when this repo is a slot at
    // <stack>/workspaces/<ws>/<repo>; a standalone monorepo checkout may cache
    // the same generated tree under .angee/runtime as a fallback.
    // TypeScript tries the paths in order, so neither topology is hard-coded
    // as the only valid host for the addon subtree.
    "paths": {
      "@angee/gql/*": [
        "../../../../../runtime/gql/*",
        "../../.angee/runtime/gql/*"
      ]
    },
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  }
}
