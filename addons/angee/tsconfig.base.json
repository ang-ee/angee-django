{
  "compilerOptions": {
    // Base-addon fragments typecheck against the stack's composed generated
    // documents: a stack is the host, so the fixture is the stack root's own
    // runtime/gql (this repo is a slot at <stack>/workspaces/<ws>/<repo>).
    // The addon subtree owns this one fixture path.
    "paths": {
      "@angee/gql/*": ["../../../../../runtime/gql/*"]
    },
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  }
}
