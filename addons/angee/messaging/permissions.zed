// Authorization schema for the messaging addon.
// @rebac_package: messaging
// @rebac_package_version: 0.1.0
// @rebac_schema_revision: 15

// Threads without a channel carry transferable ownership; dependent rows inherit
// access from their thread, message or channel. Creation attribution grants no access.
// A Channel inherits access from its integrate/integration parent.

definition messaging/channel {
    relation integration: integrate/integration // rebac:field=integration_ptr
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = admin->member
    permission read   = integration->read + reader + admin->member
    permission write  = integration->write + admin->member
    permission delete = integration->write + admin->member
}

definition messaging/thread {
    relation channel: messaging/channel // rebac:field=channel
    relation owner: auth/user // rebac:field=owner
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = channel->read + owner + editor + reader + admin->member
    permission write  = channel->write + owner + editor + admin->member
    permission share  = owner + editor + admin->member
    permission delete = owner + channel->delete + admin->member
    permission transfer = owner + admin->member
    permission write__owner = transfer
}

// A trashed message is withheld from every reader but its channel's managers
// and admins. Record chatter moderators reach trashed comments through the
// record-gated removed list instead, so its parts, files and reactions follow.
definition messaging/message {
    relation thread: messaging/thread // rebac:field=thread
    relation channel: messaging/channel // rebac:field=channel
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation trashed: messaging/message // rebac:const={"target_id":"trashed","filters":{"is_trashed":true}}
    relation admin: angee/role // rebac:const=admin

    // The trashed sentinel needs no target row because this permission is
    // authenticated. Arrow-only through `trashed`; never check it directly.
    permission conceal = authenticated
    permission withheld = trashed->conceal
    permission create = authenticated
    permission read   = ((thread->read + channel->read + editor + reader) - withheld) + channel->write + admin->member
    permission write  = thread->write + channel->write + editor + admin->member
    permission delete = thread->delete + channel->write + editor + admin->member
}

definition messaging/thread_attachment {
    relation thread: messaging/thread // rebac:field=thread
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = thread->read + editor + reader + admin->member
    permission write  = thread->write + editor + admin->member
    permission delete = thread->write + admin->member
}

definition messaging/thread_follower {
    relation thread: messaging/thread // rebac:field=thread
    relation attachment: messaging/thread_attachment // rebac:field=attachment
    relation user: auth/user // rebac:field=party__person__user
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = user + thread->read + attachment->read + admin->member
    permission write  = user + thread->write + attachment->write + admin->member
    permission delete = user + thread->write + attachment->write + admin->member
}

definition messaging/activity_type {
    relation admin: angee/role // rebac:const=admin

    permission read = authenticated
    permission create = admin->member
    permission write = admin->member
    permission delete = admin->member
}

definition messaging/thread_activity {
    relation thread: messaging/thread // rebac:field=thread
    relation attachment: messaging/thread_attachment // rebac:field=attachment
    relation user: auth/user // rebac:field=user
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = user + thread->read + attachment->read + admin->member
    permission write  = user + thread->write + attachment->write + admin->member
    permission delete = user + thread->write + attachment->write + admin->member
}

definition messaging/thread_notification {
    relation thread: messaging/thread // rebac:field=thread
    relation attachment: messaging/thread_attachment // rebac:field=attachment
    relation message: messaging/message // rebac:field=message
    relation user: auth/user // rebac:field=user
    relation admin: angee/role // rebac:const=admin

    permission read_inbox = user
    permission create = authenticated
    permission read   = user + thread->read + attachment->read + message->read + admin->member
    permission write  = user + admin->member
    permission delete = user + admin->member
}

definition messaging/part {
    relation message: messaging/message // rebac:field=message
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = message->read + editor + reader + admin->member
    permission write  = message->write + editor + admin->member
    permission delete = message->delete + admin->member
}

definition messaging/tracking_value {
    relation message: messaging/message // rebac:field=message
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = message->read + editor + reader + admin->member
    permission write  = message->write + editor + admin->member
    permission delete = message->write + admin->member
}

// A Fragment is content-addressed and shared across owners (dedup by text hash),
// so it carries no REBAC type — a per-owner read on a shared row would hide the
// text from every owner but the first. Its visibility rides the owning part/message
// (each gated below); the row is reached only through a readable part, never alone.

definition messaging/message_edge {
    relation src: messaging/message // rebac:field=src
    relation dst: messaging/message // rebac:field=dst
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = (src->read & dst->read) + editor + reader + admin->member
    permission write  = (src->write & dst->write) + editor + admin->member
    permission delete = src->delete + dst->delete + admin->member
}

definition messaging/participant {
    relation thread: messaging/thread // rebac:field=thread
    // Participants without a message are thread memberships; only these inherit
    // thread write/delete permissions.
    relation membership_thread: messaging/thread // rebac:field={"path":"thread","filters":{"message__isnull":true}}
    relation message: messaging/message // rebac:field=message
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = thread->read + message->read + editor + reader + admin->member
    permission write  = membership_thread->write + message->write + editor + admin->member
    permission delete = membership_thread->delete + message->delete + admin->member
}

definition messaging/reaction {
    relation message: messaging/message // rebac:field=message
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = message->read + editor + reader + admin->member
    permission write  = message->write + editor + admin->member
    permission delete = message->delete + admin->member
}

definition messaging/message_star {
    relation message: messaging/message // rebac:field=message
    relation user: auth/user // rebac:field=user
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = user + message->read + admin->member
    permission write  = user + admin->member
    permission delete = user + admin->member
}
