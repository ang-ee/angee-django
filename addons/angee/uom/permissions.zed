// Authorization schema for the uom addon.
// @rebac_package: uom
// @rebac_package_version: 0.1.0
// @rebac_schema_revision: 2

// Roles-as-namespace anchor, mirroring sequence/role: `includes` lets one uom
// role imply another, and resources gate on `effective_member` so granted +
// implied members both resolve. Platform admins (angee/role:admin) reach every
// uom role through the const-backed `admin` relation — synthetic, no per-object
// tuple — the same universal-admin path the resource types below use.
definition uom/role {
    relation member:   auth/user | auth/group#member | angee/role:admin#member
    relation includes: uom/role
    relation admin:    angee/role // rebac:const=admin

    permission effective_member = member + includes->effective_member + admin->member
}

// Units of measure are a shared master catalogue: every authenticated user reads
// them (items and records reference units). Platform admins create
// catalogue rows; stored uom_admin manager bindings govern existing rows.
definition uom/category {
    relation shared:  auth/user:*
    relation admin:   angee/role // rebac:const=admin
    relation manager: uom/role:uom_admin

    permission create = admin->member + manager->effective_member
    permission read   = shared + admin->member + manager->effective_member
    permission write  = admin->member + manager->effective_member
    permission delete = admin->member + manager->effective_member
}

definition uom/uom {
    relation shared:  auth/user:*
    relation admin:   angee/role // rebac:const=admin
    relation manager: uom/role:uom_admin

    permission create = admin->member + manager->effective_member
    permission read   = shared + admin->member + manager->effective_member
    permission write  = admin->member + manager->effective_member
    permission delete = admin->member + manager->effective_member
}
