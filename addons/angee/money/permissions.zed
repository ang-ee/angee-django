// Authorization schema for the money addon.
// @rebac_package: money
// @rebac_package_version: 0.1.0
// @rebac_schema_revision: 3

// Explicit role members and platform admins manage money records.
definition money/role {
    relation member:   auth/user | auth/group#member | angee/role:admin#member
    relation admin:    angee/role // rebac:const=admin

    permission effective_member = member + admin->member
}

// Currencies are a shared master catalogue: every authenticated user reads them
// (items and records reference a currency). Platform admins create
// catalogue rows; stored money_admin manager bindings govern existing rows.
definition money/currency {
    relation admin:   angee/role // rebac:const=admin
    relation manager: money/role:money_admin

    permission create = admin->member + manager->effective_member
    permission read   = authenticated
    permission write  = admin->member + manager->effective_member
    permission delete = admin->member + manager->effective_member
}

// Global rates derive shared reads from their own context/reference columns.
// Contextual or source-owned rates are scoped by composing product addons.
definition money/rate {
    relation admin:   angee/role // rebac:const=admin
    relation manager: money/role:money_admin
    relation shared:  money/rate // rebac:const={"target_id":"shared","filters":{"context_content_type_id__isnull":true,"context_object_id":"","reference_currency_id__isnull":true}}

    // The shared sentinel needs no target row because this permission is authenticated.
    // Arrow-only through shared: never check directly or use as an action/field gate;
    // doing so bypasses the context/reference filters. Check read on the rate instead.
    permission shared_reader = authenticated
    permission create = admin->member + manager->effective_member
    permission read   = shared->shared_reader + admin->member + manager->effective_member
    permission write  = admin->member + manager->effective_member
    permission delete = admin->member + manager->effective_member
}
