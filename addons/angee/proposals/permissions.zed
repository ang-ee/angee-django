// Authorization schema for sealed proposal rounds.
// @rebac_package: proposals
// @rebac_package_version: 0.1.0
// @rebac_schema_revision: 2

definition proposals/round {
    relation task:        projects/task    // rebac:field=task
    relation project:     projects/project // rebac:field=project
    relation facilitator: auth/user        // rebac:field=facilitator
    relation reader:      auth/user
    relation evaluator:   auth/user
    relation requester:   auth/user
    relation person:      iam/kind // rebac:const=person

    permission facilitate = facilitator & person->active_member
    permission evaluate = evaluator & person->active_member
    permission create = task->write + project->write
    permission read   = facilitate + reader + evaluate + requester
    permission write  = facilitate
    permission share  = facilitate
    permission delete = facilitate
}

definition proposals/topic {
    relation round: proposals/round // rebac:field=round

    permission create = round->write
    permission read   = round->read
    permission write  = round->write
    permission delete = round->write
}

definition proposals/proposal {
    relation responder: auth/user       // rebac:field=responder
    relation round:     proposals/round // rebac:field=round
    relation editor:    auth/user
    relation reader:    auth/user

    permission create   = round->facilitate
    permission read     = responder + reader + round->facilitate + round->evaluate + round->requester
    permission write    = editor + round->facilitate
    permission evaluate = round->evaluate + round->facilitate
    permission publish  = responder + round->facilitate
    permission withdraw = responder + round->facilitate
    permission delete   = editor + round->facilitate

    permission read__cost            = responder + round->facilitate + round->evaluate + round->requester
    permission read__currency        = responder + round->facilitate + round->evaluate + round->requester
    permission read__staffing        = responder + round->facilitate + round->evaluate + round->requester
    permission read__confidence      = responder + round->facilitate + round->evaluate + round->requester
    permission read__timeframe_start = responder + round->facilitate + round->evaluate + round->requester
    permission read__timeframe_end   = responder + round->facilitate + round->evaluate + round->requester
    permission read__valid_until     = responder + round->facilitate + round->evaluate + round->requester
    permission read__source_message  = responder + round->facilitate + round->evaluate + round->requester
}

definition proposals/answer {
    relation proposal: proposals/proposal // rebac:field=proposal

    permission create = proposal->write
    permission read   = proposal->read
    permission write  = proposal->write
    permission delete = proposal->write
}

definition proposals/review {
    relation proposal: proposals/proposal // rebac:field=proposal
    relation reviewer: auth/user          // rebac:field=reviewer
    relation person: iam/kind // rebac:const=person

    permission create = reviewer & proposal->evaluate
    permission read   = reviewer + proposal->evaluate
    permission write  = reviewer & person->active_member
    permission delete = reviewer & person->active_member
}
