// Authorization schema for operational queues and their named stages.
// @rebac_package: work
// @rebac_package_version: 0.1.0
// @rebac_schema_revision: 5

// Queue is an MTI child of spaces/group. Its inherited roster and visibility
// remain owned by that parent row; this child merely delegates to it.
definition work/queue {
    relation group: spaces/group // rebac:field=group_ptr

    permission create = authenticated
    permission withheld = nil
    permission read   = group->write + (group->read - withheld)
    permission post   = group->post
    permission write  = group->write
    permission share  = group->manage_roster
    permission write__owner = group->transfer
    permission delete = group->delete
}

definition work/stage {
    relation queue: work/queue // rebac:field=queue

    permission create = queue->write
    permission read   = queue->read
    permission write  = queue->write
    permission delete = queue->write
    permission conceal = authenticated
}

definition work/cycle {
    relation queue: work/queue // rebac:field=queue

    permission create = queue->write
    permission read   = queue->read
    permission write  = queue->write
    permission delete = queue->write
}
