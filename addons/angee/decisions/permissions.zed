// @rebac_package: decisions
// @rebac_package_version: 0.1.0
// @rebac_schema_revision: 4

definition decisions/group {
    relation root: decisions/group // rebac:field=reask_root
    relation issuer: auth/user // rebac:field=issuer
    relation assignee: auth/user // rebac:field=decisions__assignees
    relation requester: auth/user // rebac:field=decisions__requester
    relation admin: angee/role // rebac:const=admin
    permission create = admin->member
    // Waiter addons contribute a leaf permission; the chain never recurses.
    permission waiter_read = nil
    permission chain_waiter_read = waiter_read + root->waiter_read
    permission read = issuer + assignee + requester + admin->member + chain_waiter_read
    permission write = admin->member
    permission delete = admin->member
}

definition decisions/decision {
    relation group: decisions/group // rebac:field=group
    relation assignee: auth/user // rebac:field=assignees
    relation requester: auth/user // rebac:field=requester
    relation issuer: auth/user // rebac:field=group__issuer
    relation person: iam/kind // rebac:const=person
    relation admin: angee/role // rebac:const=admin
    permission create = admin->member
    permission read = assignee + requester + issuer + admin->member + group->chain_waiter_read
    permission act = ((assignee - requester) + admin->member) & person->active_member
    permission write = admin->member
    permission delete = admin->member
}

definition decisions/evidence {
    relation decision: decisions/decision // rebac:field=decision
    relation admin: angee/role // rebac:const=admin
    permission create = admin->member
    permission read = decision->read
    permission write = admin->member
    permission delete = admin->member
}
