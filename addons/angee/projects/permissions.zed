// Authorization schema for bounded projects and their work.
// @rebac_package: projects
// @rebac_package_version: 0.1.0
// @rebac_schema_revision: 13

definition projects/project {
    relation owner:  auth/user // rebac:field=owner
    relation reader: auth/user | auth/group#member
    relation editor: auth/user | auth/group#member
    relation admin:  angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = owner + reader + editor + admin->member
    permission write  = owner + editor + admin->member
    permission share  = owner + editor + admin->member
    permission delete = owner + admin->member
    permission transfer = owner + admin->member
    permission write__owner = transfer
    permission write__owns_items = share
}

definition projects/milestone {
    relation project: projects/project // rebac:field=project
    relation admin:   angee/role // rebac:const=admin

    permission create = project->write + admin->member
    permission read   = project->read + admin->member
    permission write  = project->write + admin->member
    permission reach = project->write + admin->member
    permission delete = project->write + admin->member
}

// A record task (one whose subject is a record's chatter edge) answers to its
// record alone: the record's readers read it, the record's writers write, share,
// complete and delete it, and its own grants count only on a task about no
// record (`unbound`). A record type takes tasks once its owner declares
// `record_read` and `record_write` for it on messaging/thread_attachment. A task
// takes record tasks too: they inherit `read_as_subject` and `write_as_subject`,
// its direct holders, which never run through its own subject, so task access
// never recurses. Contributors whose readers should see a task's record tasks
// extend them (work lends its queue). Project readers are not lent: that arrow
// takes generic target unions past SQLite's expression depth. A withheld task
// withholds its record tasks (`subject->record_withheld`), subtracted beside the
// subject arm rather than inside it for the same reason.
definition projects/task {
    relation project: projects/project // rebac:field=project
    relation subject: messaging/thread_attachment // rebac:field=subject
    relation parent: projects/task // rebac:field=parent
    relation promoted_project: projects/project // rebac:field=promoted_projects
    relation inherited_project: projects/project // rebac:field={"path":"project","filters":{"visibility":"inherited"}}
    relation owner: auth/user // rebac:field=owner
    relation assignee: auth/user // rebac:field=assignee
    relation reader: auth/user | auth/group#member
    relation editor: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin
    // Const-backed on the row's own subject: the relation exists only on a task
    // about no record, so `unbound->free` holds exactly there.
    relation unbound: projects/task // rebac:const={"target_id":"unbound","filters":{"subject_id__isnull":true}}

    // The sentinel's target, held by everyone: it gates nothing alone. Arrow-only
    // through `unbound`: never check `free` directly.
    permission free = authenticated
    permission create = (authenticated - subject->attached) + subject->record_write + admin->member
    permission read_granted = inherited_project->read + owner + assignee + reader + editor
    permission withheld = nil
    permission read = (((read_granted & unbound->free) + subject->record_read) - withheld - subject->record_withheld) + admin->member
    permission read_as_subject = owner + assignee + reader + editor + admin->member
    permission read_promoted_phase = promoted_project->read + admin->member
    permission write_granted = inherited_project->write + owner + assignee + editor
    permission write_withheld = nil
    permission write = (((write_granted & unbound->free) + subject->record_write) - withheld - write_withheld - subject->record_withheld) + admin->member
    permission write_as_subject = owner + assignee + editor + admin->member
    permission share_granted = inherited_project->share + owner + editor
    permission share = (((share_granted & unbound->free) + subject->record_write) - withheld) + admin->member
    permission narrow = write
    permission widen = ((project->share + owner) & unbound->free) + subject->record_write + admin->member
    permission delete_granted = inherited_project->write + owner
    permission delete = (((delete_granted & unbound->free) + subject->record_write) - withheld) + admin->member
    permission transfer = (owner & unbound->free) + subject->record_write + admin->member
    permission write__owner = transfer
    permission comment_granted = write_granted
    permission comment_withheld = nil
    permission comment = (((comment_granted & unbound->free) + subject->record_write) - withheld - comment_withheld) + admin->member
    permission write__assignee = share
    // Who brings a withheld task back. Contributors that withhold tasks name their
    // managers here; administrators always may.
    permission restore = admin->member
}

// The resource-declared kinds of record task; everyone reads the catalog.
definition projects/activity_type {
    relation admin: angee/role // rebac:const=admin

    permission read = authenticated
    permission create = admin->member
    permission write = admin->member
    permission delete = admin->member
}

definition projects/task_relation {
    relation task:         projects/task // rebac:field=task
    relation related_task: projects/task // rebac:field=related_task
    relation admin:        angee/role // rebac:const=admin

    permission create = task->write + admin->member
    permission read   = (task->read & related_task->read) + admin->member
    permission write  = task->write + admin->member
    permission delete = task->write + admin->member
}

definition projects/participant {
    relation project: projects/project // rebac:field=project
    relation admin:   angee/role // rebac:const=admin

    permission create = project->write + admin->member
    permission read   = project->read + admin->member
    permission write  = project->write + admin->member
    permission delete = project->write + admin->member
}

// A link names its target through its GenericForeignKey: one relation per
// target type, backed by `target`, so every link permission follows the
// project or task it is attached to. A target type no relation names is
// refused under an actor.
definition projects/link {
    relation project: projects/project // rebac:field=target
    relation task:    projects/task // rebac:field=target
    relation admin:   angee/role // rebac:const=admin

    permission create = project->write + task->write + admin->member
    permission read   = project->read + task->read + admin->member
    permission write  = project->write + task->write + admin->member
    permission delete = project->write + task->write + admin->member
}

// A binding names its resource through its GenericForeignKey: one relation per
// bindable type, backed by `target` (a channel binds as its integration).
// Binding widens the resource to the project's members, so creating or
// deleting one takes share on the project and the resource's own grant
// authority: share where its type grants it, write otherwise. A binding is not
// moved: unbind, then bind the other resource.
definition projects/project_binding {
    relation project: projects/project // rebac:field=project
    relation drive: storage/drive // rebac:field=target
    relation folder: storage/folder // rebac:field=target
    relation integration: integrate/integration // rebac:field=target
    relation thread: messaging/thread // rebac:field=target
    relation vault: knowledge/vault // rebac:field=target
    relation admin: angee/role // rebac:const=admin

    permission target_share = drive->share + folder->write + integration->write + thread->share + vault->share
    permission create = project->share & target_share
    permission read = project->read + admin->member
    permission write = nil
    permission delete = project->share & target_share
}
