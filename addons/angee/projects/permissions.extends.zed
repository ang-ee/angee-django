// Project-owned container access contributed to upstream resource definitions.
// @rebac_package: projects
// @rebac_schema_revision: 4

definition storage/drive {
    relation project: projects/project // rebac:field=project_bindings__project

    permission read = project->read
    permission write = project->write
    permission share = project->share
}

definition storage/file {
    relation task_record: projects/task // rebac:field={"path":"attachments__task","filters":{"visibility":"record"}}

    permission read = task_record->read
    permission write = task_record->write
    permission share = task_record->share
}

definition storage/folder {
    relation project: projects/project // rebac:field=project_bindings__project
    relation home_project: projects/project // rebac:field=projects

    permission read = project->read + home_project->read
    permission write = project->write + home_project->write
}

// A Channel inherits Integration access. Thread and Message then inherit that
// access from Channel through their own field-backed channel relations.
definition integrate/integration {
    relation project: projects/project // rebac:field=project_bindings__project

    permission read = project->read
    permission write = project->write
    permission delete = project->write
}

definition messaging/thread {
    relation project: projects/project // rebac:field=project_bindings__project
    relation record_project: projects/project // rebac:field={"path":"attachments__projects_project","filters":{"attachments__role":"chatter"}}
    relation record_task: projects/task // rebac:field={"path":"attachments__projects_task","filters":{"attachments__role":"chatter"}}

    permission read = project->read + record_project->read + record_task->read
    permission write = project->write
}

definition knowledge/vault {
    relation project: projects/project // rebac:field=project_bindings__project

    permission read = project->read
    permission write = project->write
    permission share = project->share
}

definition knowledge/record_binding {
    relation task: projects/task // rebac:field=task
    relation project: projects/project // rebac:field=project

    permission read = (page->read + vault->read) & (task->read + project->read)
}
