// Authorization schema for external-request evidence.
// @rebac_package: intake
// @rebac_package_version: 0.1.0
// @rebac_schema_revision: 2

definition intake/need {
    relation task:    projects/task    // rebac:field=task
    relation project: projects/project // rebac:field=project

    permission create = task->write + project->write
    permission read   = task->read + project->read
    permission write  = task->write + project->write
    permission delete = task->write + project->write

    permission write__party = task->share + project->share
    permission read__claimed_email = task->write + project->write
    permission read__access_verdict = task->share + project->share
    permission read__access_resolved_by = task->share + project->share
    permission read__access_resolved_at = task->share + project->share
    permission read__access_resolution = task->share + project->share
}
