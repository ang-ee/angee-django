// Authorization schema for the spaces addon.
// @rebac_package: spaces
// @rebac_package_version: 0.1.0
// @rebac_schema_revision: 8

definition spaces/group {
    relation owner: auth/user // rebac:field=owner
    relation roster_owner: auth/user // rebac:field={"path":"memberships__party__person__user","filters":{"memberships__is_confirmed":true,"memberships__is_dismissed":false,"memberships__role":"owner"}}
    relation roster_moderator: auth/user // rebac:field={"path":"memberships__party__person__user","filters":{"memberships__is_confirmed":true,"memberships__is_dismissed":false,"memberships__role":"moderator"}}
    relation roster_member: auth/user // rebac:field={"path":"memberships__party__person__user","filters":{"memberships__is_confirmed":true,"memberships__is_dismissed":false,"memberships__role":"member"}}
    relation roster_viewer: auth/user // rebac:field={"path":"memberships__party__person__user","filters":{"memberships__is_confirmed":true,"memberships__is_dismissed":false,"memberships__role":"viewer"}}
    relation reader: spaces/group // rebac:const={"target_id":"shared","filters":{"visibility":"public"}}
    relation admin: angee/role // rebac:const=admin

    // The shared sentinel needs no target row because this permission is authenticated.
    // Arrow-only through reader: never check directly or use as an action/field gate;
    // doing so bypasses visibility. Check read on the group or its child instead.
    permission shared_reader = authenticated
    permission create = authenticated
    permission read   = owner + roster_viewer + roster_member + roster_moderator + roster_owner + reader->shared_reader + admin->member
    permission post   = owner + roster_member + roster_moderator + roster_owner + admin->member
    permission write  = owner + roster_moderator + roster_owner + admin->member
    permission delete = owner + roster_owner + admin->member
    permission transfer = owner + admin->member
    permission write__owner = transfer
    permission manage_roster = owner + roster_owner + admin->member
}

definition spaces/membership {
    relation group: spaces/group // rebac:field=group
    relation member_of: spaces/group // rebac:field={"path":"group","filters":{"role":"member"}}
    relation viewer_of: spaces/group // rebac:field={"path":"group","filters":{"role":"viewer"}}
    relation holder: auth/user // rebac:field={"path":"party__person__user","filters":{"is_confirmed":true,"is_dismissed":false}}
    relation admin: angee/role // rebac:const=admin

    permission create = group->manage_roster + member_of->write + viewer_of->write + admin->member
    permission read   = group->read + admin->member
    permission write  = group->manage_roster + member_of->write + viewer_of->write + admin->member
    permission delete = group->manage_roster + member_of->write + viewer_of->write + admin->member
    permission write__role = group->manage_roster + admin->member
    permission write__group = admin->member
    permission set_notifications = holder
}
