// Authorization schema for the IAM addon.
// @rebac_package: iam
// @rebac_package_version: 0.1.0
// @rebac_schema_revision: 23

definition auth/user {
    // Const-backed universal admin: every user points at angee/role:admin
    // (synthetic — no per-user tuple), so admin->member resolves the actor's
    // platform-admin membership. The role accepts direct user and group grants;
    // Django's is_superuser flag does not define membership.
    relation admin: angee/role // rebac:const=admin
    relation directory: iam/directory // rebac:const=main
    relation directory_reader: auth/user
    // Each account's own person, live from its primary key: no tuple.
    relation self: auth/user // rebac:attribute={"field":"id"}

    permission create = admin->member
    permission view_as = admin->member
    // Everyone signed in reads a person's name wherever a record embeds the
    // account; the restricted fields below keep everything else.
    permission read = authenticated
    // People managers: platform admins, the named readers of the whole
    // directory or of one account, and the roles a consumer unions in from its
    // fragment. They list every account and read its restricted fields.
    permission list = directory_reader + directory->reader + admin->member
    // The people a member is offered in pickers: their own account, every
    // account for people managers, and the colleagues identity owners union in
    // from their fragments.
    permission colleague = self + list
    // Restricted fields: the sign-in identity, last sign-in, access state and
    // UI preferences, for people managers and the person.
    permission read_private = self + list
    permission read__username = read_private
    permission read__email = read_private
    permission read__last_login = read_private
    permission read__is_active = read_private
    permission read__is_staff = read_private
    permission read__preferences = read_private
    permission write = admin->member
    permission delete = admin->member

    // Identity, credential and authority columns stay with administrators even
    // where a consumer grants `write` (which then edits the name fields).
    permission write__username = admin->member
    permission write__email = admin->member
    permission write__password = admin->member
    permission write__kind = admin->member
    permission write__is_active = admin->member
    permission write__is_staff = admin->member
    permission write__is_superuser = admin->member
    // A person's UI preferences and the account's audit dates: never through a
    // consumer's `write`. Self-service preferences save under a system context.
    permission write__preferences = admin->member
    permission write__date_joined = admin->member
    permission write__last_login = admin->member

    // Account verbs. Each refuses protected accounts (see iam/protected).
    permission issue_password = admin->member
    permission reset_password = admin->member
    permission set_active = admin->member
    permission rename = admin->member

    // Generic updates of a protected account (the actor's own included).
    permission administer = admin->member
}

// The whole people directory's named readers. No wildcard: the full user list
// is never everyone's.
definition iam/directory {
    relation reader: auth/user
}

// Accounts whose authority account verbs, non-administrator updates and
// view-as never act on, beyond staff and superusers: the effective members of
// `iam/protected:main#member`. A consumer adds its elevated role from its own
// permissions.extends.zed with a const-backed relation unioned into `member`.
definition iam/protected {
    relation admin: angee/role // rebac:const=admin

    permission member = admin->effective_member
}

// Kind and activity are live user facts, including bulk-created/updated rows.
// Fixed containers: `iam/kind:person` is the only kind any schema references,
// and the kind column is an enum, so it cannot key a dynamic container.
definition iam/kind {
    relation member: auth/user // rebac:attribute={"field":"kind","resource":"person","value":"person"}
    relation active_member: auth/user // rebac:attribute={"field":"kind","resource":"person","value":"person","filters":{"is_active":true}}
    relation active_actor: auth/user // rebac:attribute={"field":"is_active","resource":"person","value":true}
}

definition auth/group {
    relation member: auth/user
    relation admin: angee/role // rebac:const=admin

    permission create = admin->member
    permission read = member + admin->member
    permission write = admin->member
    permission delete = admin->member
}

definition angee/role {
    relation member: auth/user | auth/group#member

    permission effective_member = member
}
