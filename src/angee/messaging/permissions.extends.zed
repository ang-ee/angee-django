// Thread readers see identity facts of explicit followers through admitted
// thread_follower rows. Following grants no party or person page access.
// @rebac_package: messaging
// @rebac_schema_revision: 5

// A follower's account may remain a colleague picker candidate without
// granting read on the account's person or party page.
definition auth/user {
    relation followed_thread: messaging/thread // rebac:field=person__party_ptr__thread_followers__thread
    permission colleague = followed_thread->read
}

// A file referenced by a message part follows that part's read permission.
// The reverse path is live-backed by Part.file, so deleting or changing a part
// immediately removes its read reach without granting access to the drive.
definition storage/file {
    relation message_part: messaging/part // rebac:field=message_parts
    permission read_granted = message_part->read
}

// Threads and messages carry tags: adding or removing one needs write on the
// record, and a record's tags are visible to its readers.
definition tags/tag_assignment {
    relation thread: messaging/thread // rebac:field=target
    relation message: messaging/message // rebac:field=target

    permission target_read = thread->read + message->read
    permission target_write = thread->write + message->write
}
