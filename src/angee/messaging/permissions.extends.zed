// Thread readers may read the identities of explicit followers.
// A public group's thread readable by every signed-in user exposes its followers'
// identities to every signed-in user too; private fields remain gated.
// @rebac_package: messaging
// @rebac_schema_revision: 5

definition parties/party {
    relation followed_thread: messaging/thread // rebac:field=thread_followers__thread

    permission read_granted = followed_thread->read
}

definition parties/person {
    relation followed_thread: messaging/thread // rebac:field=party_ptr__thread_followers__thread

    permission read_granted = followed_thread->read
}

// The sender's contact point is part of a readable message's envelope. Its
// linked Party and private directory data retain their independent gates.
// This live source relation withdraws access with message trash or revocation.
definition parties/handle {
    relation sent_message: messaging/message // rebac:field=sent_messages
    permission read = sent_message->read
}

// A file referenced by a message part follows that part's read permission.
// The reverse path is live-backed by Part.file, so deleting or changing a part
// immediately removes its read reach without granting access to the drive.
definition storage/file {
    relation message_part: messaging/part // rebac:field=message_parts
    permission read = message_part->read
}

// Threads and messages carry tags: annotators may add or remove them on readable
// records without content-edit access. A record's tags are visible to its readers.
definition tags/tag_assignment {
    relation thread: messaging/thread // rebac:field=target
    relation message: messaging/message // rebac:field=target

    permission target_read = thread->read + message->read
    permission target_write = thread->annotate + message->annotate
}
