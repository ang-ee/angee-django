// Authorization schema for the parties addon.
// @rebac_package: parties
// @rebac_package_version: 0.1.0
// @rebac_schema_revision: 36

// Parties, folders and circles are grant roots: each is owned through its
// transferable `owner` column (OwnerMixin), which an insert defaults to the row's
// creator; `created_by` stays attribution. The owner, or a platform admin through
// the const-backed `angee/role:admin` membership (no per-row tuple), transfers it.
// Person and Organization read their inherited owner column and delegate owner
// writes to their party's `transfer`.
//
// Dependent rows (handles, addresses, relationships, circle memberships) and
// user-added relationship kinds are never transferred: their access belongs to
// their `creator` (`created_by`). Each names its own creator rather than reaching
// through the party, so a handle synced for an unknown sender (party still null)
// stays readable. An address or relationship changes its party's projection (a
// two-way directory writes it to the remote card), so creating one takes write
// on that party, evaluated on the unsaved row; reading the party lends none. A
// directory's contact readers also read the handles, addresses and
// relationships its own live links state, never another source's, and never a
// handle its link only claims for review.

// Other addons' records (a followed thread, a filed task) may contribute identity
// read arms. Private fields and private uses of a party require read_private,
// which retains per-row grants. An explicit `reader` grant on an MTI child also
// reaches each parent that accepts the relation and subject through the resources
// grant loader (`src/angee/resources/grants.py`). Related rows keep their own
// read rules. identity_reader, granted on the canonical Party, shares only its
// basic identity: the Person or Organization row reads it through `party`,
// without lending private data or related subject records.
// Lossless contact data and handle counts are private. created_by,
// updated_by and their labels remain readable: attribution belongs to identity.

// Parties' roles hold on every party what a per-record grant holds on one: a
// contact reader reads as a `reader` does, a contact manager writes as an
// `editor` does, a contact admin also deletes and transfers as an owner does.
// A deployment grants their membership (the Permissions Hub, or a grants
// resource row); parties grants them to nobody. Platform admins hold each.
definition parties/role {
    relation member: auth/user | auth/group#member | angee/role:admin#member
    relation admin:  angee/role // rebac:const=admin

    permission effective_member = member + admin->member
}

definition parties/party {
    relation owner: auth/user // rebac:field=owner
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation identity_reader: auth/user | auth/group#member
    // Admission follows retained source links and registered principal roles.
    relation directory: integrate/integration // rebac:field=record_links__stream__integration
    // A directory whose live link (bound, not tombstoned) names this party.
    relation linking_directory: parties/directory // rebac:field={"path":"record_links__stream__integration__directory","filters":{"record_links__tombstoned_at__isnull":true}}
    relation statement_role: provenance/role // rebac:const=parties_statement_source
    permission statement_source = directory + statement_role->effective_member
    relation admin: angee/role // rebac:const=admin
    relation person: iam/kind // rebac:const=person
    relation contact_reader: parties/role // rebac:const=contact_reader
    relation contact_manager: parties/role // rebac:const=contact_manager
    relation contact_admin: parties/role // rebac:const=contact_admin

    // What the roles hold on every party; a person and an organization read these through `party`.
    permission role_admin = contact_admin->effective_member
    permission role_manage = contact_manager->effective_member + role_admin
    permission role_read = contact_reader->effective_member + role_manage
    // Choice 1: a contact reader reads the private fields, as a per-record reader does (`role_read`);
    // `role_manage` here keeps a contact reader to identity, as `identity_reader`.
    permission role_private = role_read
    // Choice 2: trashing a party is its `delete`, which also admits deleting it, so it stays with the
    // contact admin (`role_admin`); `role_manage` here would let a contact manager trash and delete.
    permission role_delete = role_admin
    // Adoption lends a person to a directory only through who holds them, never the platform admin
    // (`parties/person#adopt`): the roles' stored members, without the admin reach of `effective_member`.
    permission role_adopt = contact_manager->member + contact_admin->member
    // Pending ruling: the roles read the record tasks about a party (`read_as_subject`) and write none;
    // `role_manage` here lets a contact manager and admin write, share, delete and transfer them.
    permission role_write_as_subject = nil
    // Pending ruling: merging a party away retires it to the trash (`Party.MERGED_PERMISSION`), which the
    // roles leave to the contact admin (`role_admin`); `role_manage` here lets a contact manager merge, and so trash.
    permission role_merge_away = role_admin
    // Pending ruling: a per-record grant outlives the role of whoever made it, so the roles leave granting
    // reads on a party or handle (`share`) to the contact admin; `role_manage` here lets a contact manager grant.
    permission role_share = role_admin

    permission create = authenticated
    // Whoever reads the contacts of a directory linking this party reads its identity.
    permission contact_read = linking_directory->contact_read
    permission read_granted = owner + editor + reader + identity_reader + contact_read + statement_source + role_read + admin->member
    permission read = read_granted
    // What a party lends the record tasks about it: its direct holders only, so
    // task access never recurses through a thread the party follows (rebac.E016).
    // A source states the party, never the record tasks about it: it admits through `write` alone.
    permission read_as_subject = owner + editor + reader + role_read + admin->member
    permission write_as_subject = owner + editor + role_write_as_subject + admin->member
    permission read_private = owner + editor + reader + role_private + admin->member
    permission read__notes = read_private
    permission read__first_met_note = read_private
    permission read__handle_count = read_private
    permission write = owner + editor + statement_source + role_manage + admin->member
    // Merging records in a batch (certain same-person pairs, a selection) is a person's
    // decision: an active person account that writes the party, never a service or agent account.
    permission batch_merge = write & person->active_member
    // What merging this party away into another needs: its write, but through the roles only `role_merge_away`.
    permission merge_away = owner + editor + statement_source + role_merge_away + admin->member
    // Granting a per-record read (`Party.rebac_grantable`): its write, but through the roles only `role_share`.
    permission share = owner + editor + statement_source + role_share + admin->member
    permission delete = owner + role_delete + admin->member
    permission transfer = owner + role_admin + admin->member
    permission write__owner = transfer
}

// Person and Organization are multi-table-inheritance children of parties/party.
// Each reads the inherited owner column itself, so its child row authorizes
// independently of the parent row; owner writes delegate through the
// field-backed `party` relation to the parent's transfer.

definition parties/person {
    relation owner: auth/user // rebac:field=owner
    relation party: parties/party // rebac:field=party_ptr
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation directory: integrate/integration // rebac:field=party_ptr__record_links__stream__integration
    relation statement_role: provenance/role // rebac:const=parties_statement_source
    permission statement_source = directory + statement_role->effective_member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read_granted = owner + editor + reader + party->identity_reader + party->contact_read + statement_source + party->role_read + admin->member
    permission read = read_granted
    permission read_private = owner + editor + reader + party->role_private + admin->member
    // Field gates are per resource definition, including inherited columns. The
    // nickname is identity, like the name parts: whoever reads the person reads it.
    permission read__notes = read_private
    permission read__first_met_note = read_private
    permission read__handle_count = read_private
    permission read__birthday = read_private
    permission read__anniversary = read_private
    permission write = owner + editor + statement_source + party->role_manage + admin->member
    permission merge_away = owner + editor + statement_source + party->role_merge_away + admin->member
    permission delete = owner + party->role_delete + admin->member
    permission write__owner = party->transfer
    // Adopting the person binds a directory's contact to them: the directory becomes one of their statement
    // sources and its contact readers read them. Only who holds the person lends them so: their owner (the
    // column a transfer moves) and their editors, granted on the party; no platform-admin arm, since every
    // directory's owner is a platform admin (`parties/directory#create`).
    permission adopt = owner + editor + party->editor + party->role_adopt
}

definition parties/organization {
    relation owner: auth/user // rebac:field=owner
    relation party: parties/party // rebac:field=party_ptr
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation directory: integrate/integration // rebac:field=party_ptr__record_links__stream__integration
    relation statement_role: provenance/role // rebac:const=parties_statement_source
    permission statement_source = directory + statement_role->effective_member
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read_granted = owner + editor + reader + party->identity_reader + party->contact_read + statement_source + party->role_read + admin->member
    permission read = read_granted
    permission read_private = owner + editor + reader + party->role_private + admin->member
    permission read__notes = read_private
    permission read__first_met_note = read_private
    permission read__handle_count = read_private
    permission write = owner + editor + statement_source + party->role_manage + admin->member
    permission merge_away = owner + editor + statement_source + party->role_merge_away + admin->member
    permission delete = owner + party->role_delete + admin->member
    permission write__owner = party->transfer
}

definition parties/handle {
    relation creator: auth/user // rebac:field=created_by
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    // Person assertions retain their typed members' own read admission.
    relation directory: integrate/integration // rebac:field=party__record_links__stream__integration
    // A directory whose live link (bound, not tombstoned) asserts this handle in a current claim at
    // Party.REVIEW_CONFIDENCE (0.5) or above: a claim for review states the address as another holder's, and
    // lends the directory's contact readers nothing of that holder's handle.
    relation stating_directory: parties/directory // rebac:field={"path":"partystatement__link__stream__integration__directory","filters":{"partystatement__status":"asserted","partystatement__superseded__isnull":true,"partystatement__confidence__gte":0.5,"partystatement__link__target_object_id__isnull":false,"partystatement__link__tombstoned_at__isnull":true}}
    relation statement_role: provenance/role // rebac:const=parties_statement_source
    permission statement_source = directory + statement_role->effective_member
    relation admin: angee/role // rebac:const=admin
    // The party the handle resolves to: parties' roles reach a handle through it, as an address's,
    // so a handle no party holds yet (a mailbox's sender, a calendar's attendee) is no role's.
    relation party: parties/party // rebac:field=party

    permission create = authenticated
    permission read_granted = creator + editor + reader + statement_source + stating_directory->contact_read + party->role_read + admin->member
    permission read = read_granted
    permission write  = creator + editor + party->role_manage + admin->member
    permission share  = creator + editor + party->role_share + admin->member
    permission delete = creator + party->role_admin + admin->member
}

definition parties/address {
    relation creator: auth/user // rebac:field=created_by
    relation party: parties/party // rebac:field=party
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation directory: integrate/integration // rebac:field=party__record_links__stream__integration
    // A directory whose live link (bound, not tombstoned) states this address in a current claim.
    relation stating_directory: parties/directory // rebac:field={"path":"addressstatement__link__stream__integration__directory","filters":{"addressstatement__status":"asserted","addressstatement__superseded__isnull":true,"addressstatement__link__target_object_id__isnull":false,"addressstatement__link__tombstoned_at__isnull":true}}
    relation statement_role: provenance/role // rebac:const=parties_statement_source
    permission statement_source = directory + statement_role->effective_member
    relation admin: angee/role // rebac:const=admin

    permission create = party->write + admin->member
    permission read_granted = creator + editor + reader + statement_source + stating_directory->contact_read + party->role_read + admin->member
    permission read = read_granted
    permission write = creator + editor + statement_source + party->role_manage + admin->member
    permission delete = creator + party->role_admin + admin->member
}

// A synced folder is an address book: its directory states the folder's name
// through the address-book link targeting it (angee statements). Statement
// admission reads `write_statements` alone, so the directory reaches no other
// read or write of the folder.
definition parties/folder {
    relation owner: auth/user // rebac:field=owner
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation directory: integrate/integration // rebac:field=record_links__stream__integration
    relation admin: angee/role // rebac:const=admin
    relation contact_reader: parties/role // rebac:const=contact_reader
    relation contact_manager: parties/role // rebac:const=contact_manager
    relation contact_admin: parties/role // rebac:const=contact_admin

    permission create = authenticated
    permission read   = owner + editor + reader + contact_reader->effective_member + contact_manager->effective_member + contact_admin->effective_member + admin->member
    permission write  = owner + editor + contact_manager->effective_member + contact_admin->effective_member + admin->member
    permission write_statements = write + directory
    permission delete = owner + contact_admin->effective_member + admin->member
    permission transfer = owner + contact_admin->effective_member + admin->member
    permission write__owner = transfer
}

// Circles and relationships are the human-owned organising surfaces. A circle is
// owned like the parties it organises; a membership or relationship belongs to
// its creator. A circle NEVER gates party visibility (organising ≠ authorization
// — REBAC reader grants stay the one read owner).

definition parties/circle {
    relation owner: auth/user // rebac:field=owner
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin
    relation contact_reader: parties/role // rebac:const=contact_reader
    relation contact_manager: parties/role // rebac:const=contact_manager
    relation contact_admin: parties/role // rebac:const=contact_admin

    permission create = authenticated
    permission read   = owner + editor + reader + contact_reader->effective_member + contact_manager->effective_member + contact_admin->effective_member + admin->member
    permission write  = owner + editor + contact_manager->effective_member + contact_admin->effective_member + admin->member
    permission delete = owner + contact_admin->effective_member + admin->member
    permission transfer = owner + contact_admin->effective_member + admin->member
    permission write__owner = transfer
}

definition parties/circle_member {
    relation creator: auth/user // rebac:field=created_by
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin
    // The member: parties' roles reach a membership through the party it names.
    relation party: parties/party // rebac:field=party

    permission create = authenticated
    permission read   = creator + editor + reader + party->role_read + admin->member
    permission write  = creator + editor + party->role_manage + admin->member
    permission delete = creator + party->role_admin + admin->member
}

// The relationship vocabulary is catalogue data every signed-in user picks
// from; user-added kinds stay editable by their creator, seeded rows
// (created_by null) only by platform admins.
definition parties/relationship_kind {
    relation creator: auth/user // rebac:field=created_by
    relation admin: angee/role // rebac:const=admin

    permission create = authenticated
    permission read   = authenticated
    permission write  = creator + admin->member
    permission delete = creator + admin->member
}

definition parties/relationship {
    relation creator: auth/user // rebac:field=created_by
    // The anchor: the card this edge lives on.
    relation party: parties/party // rebac:field=party
    relation editor: auth/user | auth/group#member
    relation reader: auth/user | auth/group#member
    relation directory: integrate/integration // rebac:field=party__record_links__stream__integration
    relation other_directory: integrate/integration // rebac:field=other_party__record_links__stream__integration
    // A directory whose live link (bound, not tombstoned) states this edge in a current claim.
    relation stating_directory: parties/directory // rebac:field={"path":"relationshipstatement__link__stream__integration__directory","filters":{"relationshipstatement__status":"asserted","relationshipstatement__superseded__isnull":true,"relationshipstatement__link__target_object_id__isnull":false,"relationshipstatement__link__tombstoned_at__isnull":true}}
    relation statement_role: provenance/role // rebac:const=parties_statement_source
    permission statement_source = directory + other_directory + statement_role->effective_member
    relation admin: angee/role // rebac:const=admin

    permission create = party->write + admin->member
    permission read_granted = creator + editor + reader + statement_source + stating_directory->contact_read + party->role_read + admin->member
    permission read = read_granted
    permission write = creator + editor + statement_source + party->role_manage + admin->member
    permission delete = creator + party->role_admin + admin->member
}

// A Directory is a multi-table-inheritance child of integrate/integration (a
// contacts-sync bridge), so its access derives from the parent integration the
// way integrate_vcs/vcs_bridge does; platform admins reach all.
//
// `contact_read` shares the contacts: it reads the parties the directory's
// live links name and the handles, addresses and relationships those links
// state, never their private fields, and grants nothing of the directory, its
// integration, streams, links or credential. Its holders are the stored
// `contact_reader` grantees only, shared through the record-access surface:
// connecting a directory grants its owner (`Directory.grant_owner_contact_read`).
// A stored arm alone folds away for every actor who holds no such grant, so the
// chain from a party through its record links to a directory is planned only for
// an actor who may read a directory's contacts; a column arm (the integration's
// owner) would keep it in every read of a party, for every actor.
//
// A contact admin reads every directory and shares its contacts (`share`, which
// manages `contact_reader`); connecting, changing and removing a directory stay
// with its integration's writers and platform admins, so the roles widen nobody
// who may connect a directory to a vendor.
definition parties/directory {
    relation integration: integrate/integration // rebac:field=integration_ptr
    relation contact_reader: auth/user | auth/group#member
    relation admin: angee/role // rebac:const=admin
    relation contact_admin: parties/role // rebac:const=contact_admin

    permission create = admin->member
    permission read   = integration->read + contact_admin->effective_member + admin->member
    permission write  = integration->write + admin->member
    permission delete = integration->write + admin->member
    permission share  = write + contact_admin->effective_member
    permission contact_read = contact_reader
    permission write__owner = integration->transfer
}
