// @rebac_package: parties
// @rebac_schema_revision: 5

// A member's colleagues include active people whose party rows they read.
// Requester display projections do not admit picker entries; messaging adds a
// narrow colleague arm for accounts of followers on readable threads.
definition auth/user {
    relation person: parties/person // rebac:field={"path":"person","filters":{"is_active":true}}

    permission colleague = person->read
}

// Parties carry tags at the party, whichever kind a person or organization is,
// and handles carry their own: adding or removing one needs write on the party
// or handle, and its tags are visible to the record's readers.
definition tags/tag_assignment {
    relation party: parties/party // rebac:field=target
    relation handle: parties/handle // rebac:field=target

    permission target_read = party->read + handle->read
    permission target_write = party->write + handle->write
}
