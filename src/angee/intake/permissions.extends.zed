// Requester access is derived from the account admitted by the Need owner;
// following grants no access. An admitted Need projects its requester's display
// identity without granting a party or person page.
// @rebac_package: intake
// @rebac_package_version: 0.1.0
// @rebac_schema_revision: 9

definition projects/task {
    relation requester: auth/user // rebac:field=needs__admitted_user
    permission read_granted = requester
    permission comment_granted = requester
}

definition decisions/decision {
    relation access_need: intake/need // rebac:field=access_needs
    permission owner_managed = access_need->decision_managed
    permission owner_eligible = access_need->share
}
