// Authorization schema for the tags addon.
// @rebac_package: tags
// @rebac_package_version: 0.1.0
// @rebac_schema_revision: 6

// Named roles grant membership directly; platform admins reach every role.
definition tags/role {
    relation member:   auth/user | auth/group#member | angee/role:admin#member
    relation admin:    angee/role // rebac:const=admin

    permission effective_member = member + admin->member
}

// Tags are reference vocabulary readable by every non-anonymous actor, without
// per-row wildcard grants.
// Configuration is admin-only: a `tags_admin` (const-backed, the framework canon)
// writes the vocabulary, everyone else only reads. The candidate-aware pre-save
// gate admits an admin/manager and denies everyone else on creation.
definition tags/tag {
    relation admin:    angee/role  // rebac:const=admin
    relation manager:  tags/role   // rebac:const=tags_admin

    permission create = admin->member + manager->effective_member
    permission read   = authenticated + admin->member + manager->effective_member
    permission write  = admin->member + manager->effective_member
    permission delete = admin->member + manager->effective_member
}

// A tag assignment is authorized by the record it tags. The app that owns a
// taggable type (one composing `TaggedModel`) declares one relation for it in its
// permissions.extends.zed, backed by the edge's GenericForeignKey
// (`relation party: parties/party // rebac:field=target`), and unions the type's
// read and write into `target_read` and `target_write`. Adding or removing a tag
// needs write on the record; an edge is visible to whoever reads both the tag and
// the record. A type no relation names cannot be tagged under an actor.
definition tags/tag_assignment {
    relation tag:   tags/tag // rebac:field=tag
    relation admin: angee/role // rebac:const=admin

    permission target_read  = nil
    permission target_write = nil

    permission create = target_write
    permission read   = (tag->read & target_read) + admin->member
    permission write  = nil
    permission delete = target_write
}
