// Authorization schema for workspace-visible portfolio strategy.
// @rebac_package: portfolio
// @rebac_package_version: 0.1.0
// @rebac_schema_revision: 5

definition portfolio/role {
    relation member:   auth/user | auth/group#member | angee/role:admin#member
    relation admin:    angee/role // rebac:const=admin

    permission effective_member = member + admin->member
}

// A product or initiative is owned by its creator (OwnerMixin): the owner writes
// and hands it over; portfolio administrators reach every row.
definition portfolio/product {
    relation owner: auth/user // rebac:field=owner
    relation manager: portfolio/role // rebac:const=portfolio_admin

    permission create = manager->effective_member
    permission read   = authenticated + manager->effective_member
    permission write  = owner + manager->effective_member
    permission delete = owner + manager->effective_member
    permission transfer = owner + manager->effective_member
    permission write__owner = transfer
}

definition portfolio/initiative {
    relation owner: auth/user // rebac:field=owner
    relation manager: portfolio/role // rebac:const=portfolio_admin

    permission create = manager->effective_member
    permission read   = authenticated + manager->effective_member
    permission write  = owner + manager->effective_member
    permission delete = owner + manager->effective_member
    permission transfer = owner + manager->effective_member
    permission write__owner = transfer
}

definition portfolio/initiative_project {
    relation initiative: portfolio/initiative // rebac:field=initiative
    relation project:    projects/project      // rebac:field=project
    relation manager:    portfolio/role // rebac:const=portfolio_admin

    permission create = manager->effective_member
    permission read   = authenticated + manager->effective_member
    permission write  = manager->effective_member
    permission delete = manager->effective_member
}

// An update names its target through its GenericForeignKey: one relation per
// reportable type, backed by `target`. Report writes ride the target; portfolio
// administrators retain the workspace-wide management path. A target type no
// relation names is refused under an actor.
definition portfolio/update {
    relation project:    projects/project // rebac:field=target
    relation initiative: portfolio/initiative // rebac:field=target
    relation manager:    portfolio/role // rebac:const=portfolio_admin

    permission create = project->write + initiative->write + manager->effective_member
    permission read   = authenticated + manager->effective_member
    permission write  = project->write + initiative->write + manager->effective_member
    permission delete = project->write + initiative->write + manager->effective_member
}

definition portfolio/release {
    relation product: portfolio/product // rebac:field=product
    relation manager: portfolio/role // rebac:const=portfolio_admin

    permission create = manager->effective_member
    permission read   = authenticated + manager->effective_member
    permission write  = manager->effective_member
    permission delete = manager->effective_member
}
