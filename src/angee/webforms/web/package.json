{
  "name": "@angee/webforms",
  "version": "0.0.0",
  "license": "LGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/standalone/form.ts"
  ],
  "exports": {
    ".": "./src/index.tsx"
  },
  "angee": {
    "pages": {
      "webforms.form": {
        "entry": "./src/standalone/form.html",
        "paths": [
          "/forms/*"
        ],
        "accept": "text/html"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@angee/app": "workspace:*",
    "@angee/ui": "workspace:*",
    "survey-core": "3.2.7",
    "survey-js-ui": "3.2.7"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.41",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.10.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
