#!/usr/bin/env python
"""Django management entrypoint for the {{ project_name }} project."""

from __future__ import annotations

import os
import sys
from pathlib import Path


def main() -> None:
    """Run Django management."""

    os.environ.setdefault("ANGEE_PROJECT_DIR", str(Path(__file__).resolve().parent))
    os.environ.setdefault("DJANGO_SETTINGS_MODULE", "angee.compose.settings")
    from django.core.management import execute_from_command_line

    from angee.base.changesets import changeset

    command = sys.argv[1] if len(sys.argv) > 1 else "help"
    if command in {"runserver", "runserver_plus", "runworker", "daphne", "gunicorn", "uvicorn", "test"}:
        execute_from_command_line(sys.argv)
        return
    with changeset(fresh=True, activity="system", change_reason=f"manage.{command}"):
        execute_from_command_line(sys.argv)


if __name__ == "__main__":
    main()
