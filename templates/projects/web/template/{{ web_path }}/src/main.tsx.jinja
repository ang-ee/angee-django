import { createApp, defineBaseAddon } from "@angee/app";
import { IamLoginPage } from "@angee/iam";
import { ConsoleLayout } from "@angee/ui";
import { appearance } from "virtual:angee-appearance";

import { composedAddons, schemas } from "../../runtime/web/app";

createApp({
  addons: [
    defineBaseAddon({
      id: "host-auth",
      routes: [
        {
          name: "auth.login",
          path: "/login",
          layout: "public",
          component: IamLoginPage,
        },
      ],
    }),
    ...composedAddons,
  ],
  layouts: {
{% if console_chatter %}
    console: { chrome: ConsoleLayout },
{% else %}
    console: { chrome: ({ children }) => <ConsoleLayout showChatter={false}>{children}</ConsoleLayout> },
{% endif %}
    public: { schema: "public" },
  },
  schemas,
  defaultSchema: "console",
{% if home %}
  home: {{ home | tojson }},
{% endif %}
{% if confine_to %}
  confineTo: {{ confine_to | tojson }},
{% endif %}
  appearance,
}).mount("#root");
