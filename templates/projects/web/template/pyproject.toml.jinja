[project]
name = "{{ project_name }}"
version = "0.0.0"
requires-python = ">=3.14"
dependencies = [
  "angee[postgres]>=3,<4",
{% if addons_profile == "full" %}
  "angee-messaging-bridges>=1,<2",
  "example-notes>=3,<4",
  "example-theme>=3,<4",
{% endif %}
{% if include_arp %}
  "arp>=1,<2",
{% endif %}
]

[tool.uv]
package = false
cache-dir = "caches/uv"

[tool.uv.workspace]
members = ["addons/*/*"]
{% if framework_source_path and framework != "baked" %}

[tool.uv.sources]
# Native uv follows the source repository's workspace members and declarations.
angee = { path = "{{ framework_source_path }}", editable = true }
{% if framework_workspace %}
{% if addons_profile == "full" %}
angee-messaging-bridges = { path = "workspaces/src/angee-messaging-bridges", editable = true }
example-notes = { path = "{{ framework_source_path }}/examples/addons/example/notes", editable = true }
example-theme = { path = "{{ framework_source_path }}/examples/addons/example/theme", editable = true }
{% endif %}
{% if include_arp %}
arp = { path = "workspaces/src/angee-arp", editable = true }
{% endif %}
{% endif %}
{% endif %}
