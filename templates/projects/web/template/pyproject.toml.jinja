# This project's Python environment: `uv run manage.py …` from the project root
# resolves django-angee (and its postgres driver) with no --project flag — uv owns
# framework location, manage.py stays a thin entrypoint. `angee build` projects
# addon-owned dependencies, including direct source references, into this host's
# generated addons group.
[project]
name = "{{ project_name }}"
version = "0.0.0"
requires-python = ">=3.14"
dependencies = ["django-angee[postgres]"]

{% if framework_source_path %}

[tool.uv.sources]
# Framework editable from the local checkout ({{ framework_source_path }}) — the
# same source a `framework=source` stack runs, so host-run management commands and
# the stack share one code source.
django-angee = { path = "{{ framework_source_path }}", editable = true }
{% endif %}

[tool.uv]
# Not a distributable package — just an environment for the composed project.
package = false
default-groups = ["addons"]
# Stack-owned cache (matches the stack services' UV_CACHE_DIR); gitignored.
cache-dir = "caches/uv"

{% if olm_cxxflags %}
[tool.uv.extra-build-variables]
# python-olm (resolved from the Matrix addon's mautrix[encryption] dependency
# through the generated addons group) vendors the EOL libolm C++ source, which
# modern clang rejects; deferring template semantic checks lets the sdist build
# unchanged. Inert unless the composed group resolves python-olm. uv reads
# [tool.uv] from THIS project root, not the editable framework dep, so the flag
# must live here. GCC rejects the clang flag and needs none — a Linux render
# passes olm_cxxflags empty, which drops this block. (Remove when mautrix moves
# off libolm.)
python-olm = { CXXFLAGS = "{{ olm_cxxflags }}" }
{% endif %}

# Keep this table last as belt-and-braces hygiene for stable generated diffs;
# hatch_angee.write_block is byte-idempotent even when later tables follow it.
[dependency-groups]
# GENERATED by angee build from the enabled addons' manifests — do not edit
addons = []
