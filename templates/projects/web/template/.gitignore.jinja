# Generated composer output — emitted by the native Hatch runtime hook, never edited.
/runtime/*
!/runtime/*/
/runtime/*/*
!/runtime/*/migrations/
/dist/

# Chained-stack overlay files at the project root: a stack template renders its
# manifest + its own answers file beside the project, and secrets live in .env.
/.copier-answers.stack.yml
/.env
/.settings.yaml.lock

# Python
__pycache__/
*.py[cod]
.mypy_cache/
.venv/
# Stack/tool caches (uv's cache-dir per pyproject.toml).
/caches/

# JS
node_modules/
/{{ web_path }}/dist/
/{{ web_path }}/.vite/

# Scratch / reports
/.playwright-mcp/
/test-results/
/playwright-report/

# Native dependency edits serialize metadata publication through this lock.
/.angee-dependencies.lock
