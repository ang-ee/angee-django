# This project's JS workspace for the process-compose dev stack: the web package's
# `@angee/*: workspace:*` deps resolve against the framework packages in the local
# `workspaces/src/angee` slot and the addon fragments in source, so
# Vite serves live framework JS. The dev stack's `deps` job runs `pnpm install`
# here (source://app). Never `pnpm install` inside a slot — a private install forks
# dependency identities for every linked framework package.
packages:
  - "{{ web_path }}"
  - "src/*/*/web"
  - "workspaces/src/angee/packages/*"
  - "workspaces/src/angee/src/angee/*/web"
{% if addons_profile == "full" %}
  - "workspaces/src/angee-messaging-bridges/src/angee/*/web"
  - "workspaces/src/angee/examples/src/*/*/web"
  - "workspaces/src/angee/examples/e2e"
{% endif %}
{% if include_arp %}
  - "workspaces/src/angee-arp/src/arp/*/web"
{% endif %}
allowBuilds:
  esbuild: true
  "@tailwindcss/oxide": true

globalPnpmfile: workspaces/src/angee/packages/scripts/pnpm-policy.cjs
