# This project's JS workspace for the process-compose dev stack: the web package's
# `@angee/*: workspace:*` deps resolve against the framework packages in the local
# `workspaces/src/angee` slot and the addon fragments in source, so
# Vite serves live framework JS. The dev stack's `deps` job runs `pnpm install`
# here (source://app). Never `pnpm install` inside a slot — a private install forks
# dependency identities for every linked framework package.
packages:
  - "{{ web_path }}"
  - "addons/*/*/web"
  - "workspaces/src/angee/packages/*"
  - "workspaces/src/angee/addons/angee/*/web"
{% if addons_profile == "full" %}
  - "workspaces/src/angee-messaging-bridges/addons/angee/*/web"
  - "workspaces/src/angee/examples/addons/*/*/web"
  - "workspaces/src/angee/examples/e2e"
{% endif %}
{% if include_arp %}
  - "workspaces/src/angee-arp/addons/arp/*/web"
{% endif %}
allowBuilds:
  esbuild: true
  "@tailwindcss/oxide": true

# assistant-ui pinned EXACT: 0.14.29 / tap 0.9.15 regressed the chat composer
# (ComposerPrimitive.Input drops all typed input — seen live on demo). The
# internals (core/store/tap) float independently of the react package, so a
# fresh lockfile needs the whole family held. Re-test the agent chat before
# lifting any of these.
overrides:
  "@assistant-ui/react": 0.14.26
  "@assistant-ui/core": 0.2.20
  "@assistant-ui/store": 0.2.19
  "@assistant-ui/tap": 0.9.3
