# Framework-dev stack = a project host at the stack root (ANGEE_ROOT=.). This
# OVERWRITES the project's .gitignore with the stack-root additions: the operator's
# materialized machinery (sources, workspaces, caches, run state) and the composed
# runtime are all regenerable here. Commit what you author; ignore what a tool
# regenerates.

# Generated composer output — emitted by the native Hatch runtime hook, never edited.
/runtime/*
!/runtime/*/
/runtime/*/*
!/runtime/*/migrations/
/dist/

# The operator's runtime artifacts, durable job receipts, and resolved secrets.
/.env
/.env.*
/process-compose.yaml
/docker-compose.yaml
/.copier-answers.stack.yml
/run/
/state/
/.angee/

# Operator-materialized source machinery: clone caches, workspace worktree slots,
# and the `templates` symlink into the consolidated angee cache.
/sources/
/workspaces/
/templates

# Stack state the operator materializes on bring-up — app media/static, the
# Postgres data cluster, and optional Ollama models all live under ./data.
/data/

# Stack-owned tool caches (uv's cache-dir per pyproject.toml and friends).
/caches/
/.pnpm-store/

# Python
__pycache__/
*.py[cod]
.mypy_cache/
.venv/

# JS
node_modules/
/{{ web_path }}/dist/
/{{ web_path }}/.vite/

# Scratch / reports
/backups/
/tmp/
/output/
/*.pre-*
/.playwright-mcp/
/test-results/
/playwright-report/
