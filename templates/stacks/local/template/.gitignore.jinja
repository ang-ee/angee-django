# Local Angee instance = a git-controlled project at the stack root (ANGEE_ROOT=.).
# The project-specific wheel contains the generated runtime. Native Django history
# beside runtime models is authored, reviewed and committed; other runtime files and
# distribution outputs remain disposable build artifacts.
/runtime/*
!/runtime/*/
/runtime/*/*
!/runtime/*/migrations/
/dist/

# The operator's compiled bring-up artifacts and resolved secrets.
/.env
/docker-compose.yaml
/process-compose.yaml
/.copier-answers.stack.yml
/run/
/sources/

# Instance state the operator materializes on bring-up: app media/static (./data)
# and the Postgres data cluster (./pgdata — a sibling of ./data so the cluster stays
# outside the django container's data mount). Never committed.
/data/
/pgdata/

# Stack-owned tool caches (UV_CACHE_DIR and friends): every cache this stack's jobs
# and containers produce lives here, never in a stray nested `.angee/` or a shared
# home cache. The `templates` symlink is stack machinery for catalog resolution.
/caches/
/templates

# Python
__pycache__/
*.py[cod]
.mypy_cache/
.venv/

# JS
node_modules/
/{{ web_path }}/dist/
/{{ web_path }}/.vite/

# Scratch / reports
/.playwright-mcp/
/test-results/
/playwright-report/
