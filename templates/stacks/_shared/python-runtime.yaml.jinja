{# Python jobs and services share the host, mounts, and application environment. #}
{% if runtime_mode == "process" %}    runtime: local
    workdir: source://app
{% else %}    runtime: container
    image: {{ django_image }}
    mounts:
      - source://app:{{ container_project_dir }}
      - bind://./data:{{ container_project_dir }}/data
    workdir: {{ container_project_dir }}
{% endif %}    env:
      # Docker jobs/services share a Linux environment through the writable data
      # bind; the mounted source's host .venv remains a separate environment.
      UV_PROJECT_ENVIRONMENT: {% if runtime_mode == "process" %}".venv"{% else %}"{{ container_project_dir }}/data/.venv-linux"{% endif %}
      ANGEE_PROJECT_DIR: {% if runtime_mode == "process" %}"."{% else %}{{ container_project_dir }}{% endif %}
      DATABASE_URL: "{{ database_url }}"{% if pool_for_django and effective_serve_mode == "production" %}
      ANGEE_DB_POOL: "true"
      ANGEE_DB_POOL_MAX_SIZE: "{{ db_pool_max_size }}"
      ANGEE_DB_POOL_TIMEOUT: "{{ db_pool_timeout }}"{% endif %}
      YAMLCONF_SECRET_KEY: "${secret.secret-key}"
      ANGEE_OPERATOR_GRAPHQL_ENDPOINT: "/operator/graphql"
      ANGEE_OPERATOR_URL: "{{ operator_url }}"
      ANGEE_OPERATOR_TOKEN: "${secret.operator-token}"
      ANGEE_OPERATOR_RESTART_JOB: "{{ restart_job }}"
      ANGEE_BUILTIN_MCP_URL: "{{ mcp_url }}"
      REDIS_URL: "{{ redis_url }}"
      CACHE_URL: "{{ redis_url }}"
      CELERY_BROKER_URL: "{{ celery_broker_url }}"
{% if public_origin %}      ANGEE_PUBLIC_ORIGIN: "{{ public_origin }}"
{% if effective_serve_mode == "production" %}      # A public production host overrides the project's development defaults: no
      # debug pages, and only its own names (plus the compose-internal ones the MCP
      # endpoint and the readiness probe use) are accepted as Host.
      YAMLCONF_DEBUG: "false"
      YAMLCONF_ALLOWED_HOSTS: '["{{ ingress_domain_value }}"{% for alias in ingress_aliases|split:"," %}{% if alias %}, "{{ alias|cut:" " }}"{% endif %}{% endfor %}, "django", "localhost", "127.0.0.1"]'
{% endif %}{% endif %}{% if settings_file %}      # The final settings layer, loaded after the host's settings.yaml.
      YAMLCONF_CONFFILE: "{% if runtime_mode == "docker" %}{{ container_project_dir }}/{% endif %}{{ settings_file }}"
{% endif %}{% if uv_cache_dir %}      UV_CACHE_DIR: "{{ uv_cache_dir }}"
{% endif %}{% if sentry_dsn %}      SENTRY_DSN: "{{ sentry_dsn }}"
      SENTRY_ENVIRONMENT: "{{ effective_serve_mode }}"
{% endif %}
