{# Shared stack manifest body for BOTH stack templates. NOTE: pongo2 (the operator's #}
{# renderer) only supports SINGLE-LINE jinja comments — never span lines with one {#. #}
{# The two thin wrappers each set `stack_flavor`, `runtime_mode`, and address #}
{# variables in a `{% set %}` header, then include this one file at column 0. #}
{# Everything below is the single source of truth for the manifest. stack_flavor #}
{# selects framework-dev versus self-contained instance structure; runtime_mode #}
{# selects process versus container execution where those genuinely differ. #}
{# framework = stacks/dev — owns ingress, the framework source roster, and src workspace. #}
{#   Process uses local commands + jobs; docker folds the lifecycle into containers. #}
{#   Both modes run directly against the framework workspace's source checkouts. #}
{# instance = stacks/local — owns bootstrap-admin secrets and the static frontend. #}
{#   Its docker runtime uses the compose network and runs the lifecycle inside the #}
{#   django container command, with Caddy serving the built SPA. #}
{# Wrapper-provided variables: stack_flavor, runtime_mode, database_url, redis_url, #}
{# celery_broker_url, operator_url, mcp_url, operator_bind, pgdata_mount, and #}
{# (process only) app_source; framework_source — plus the dev copier inputs #}
{# addons_profile and work_state_source, which gate sources/workspace blocks. #}
version: 1
kind: stack
{% if stack_flavor == "framework" %}
name: {{ project_name }}
{% endif %}
{% if stack_flavor == "instance" %}
name: {{ instance_name }}
{% endif %}

template:
{% if stack_flavor == "framework" %}
  active: stacks/dev
{% endif %}
{% if stack_flavor == "instance" %}
  active: {{ _src_path }}
{% endif %}
  # The PROJECT owns the canonical .copier-answers.yml (dev is chained under a
  # workspace, local under the projects/web host); the stack keeps its OWN answers
  # file so it never clobbers the project's.
  answers_file: .copier-answers.stack.yml

{% if stack_flavor == "framework" %}
# Edge ingress. The operator's central Caddy fronts every service that declares a
# `route:` block (e.g. the agent chat WebSocket) and forward-auths each upgrade
# against the operator's /edge/verify. Without an `ingress.type: caddy` stack the
# operator treats routed services as unrouted and `agentChatEndpoint` can't hand
# the browser a reachable URL.
#
{% if ingress_domain_value == "localhost" %}# Dev uses `routing: path` + `tls: off`: one shared host with a `/<service>/` prefix
# per agent (no per-agent subdomain/DNS), and plain ws. `localhost` always resolves,
# so a freshly provisioned agent is reachable at ws://localhost:<edge_port>/<service>/
# with zero DNS or cert setup.{% else %}
# With a public DNS name, Caddy serves container routes over automatic TLS on host
# ports 443/80. Docker mode routes the Vite UX at `/`; process mode keeps its local
# frontend on ui_port because runtime-local services cannot be routed. Its routed
# container services still use TLS; the Playwright routes exist only in Docker mode.{% endif %}
ingress:
  type: caddy
  routing: path
  tls: {% if ingress_domain_value == "localhost" %}"off"   # quoted: bare YAML `off` is boolean false; the operator wants the string{% else %}auto{% endif %}
  domain: {{ ingress_domain_value }}
{% if ingress_domain_value == "localhost" %}{# edge_port applies only in localhost mode; automatic TLS pins host ports 443/80. #}  # Host port the edge publishes. 80 for the base stack; a workspace leases a distinct
  # value (operator.port_pool.edge) so parallel stacks on one host don't all fight for :80.
  port: {{ edge_port }}{% endif %}
  # The edge runs as a container; this dev stack's operator is `runtime: local`, so
  # forward_auth must reach it on the host instead of the default `operator:9000`.
  verify: host.docker.internal:{{ operator_port }}
{% endif %}

# The operator daemon owns stack-secret management. The console bearer is a
# generated secret shared by the daemon (--token) and Django (ANGEE_OPERATOR_TOKEN),
# so neither side hardcodes it. The docker-compose backend loads ./.env via
# `--env-file` unconditionally, so the env-file backend must write it before bring-up.
secrets_backend:
  type: env-file
  path: .env

secrets:
  # The instance's Django SECRET_KEY, in BOTH modes: encrypted-at-rest fields
  # (angee.base EncryptedField — e.g. integrate.oauthclient.client_secret) derive
  # their Fernet key from it, so switching a stack between process and docker
  # rendering must NEVER rotate it. The env-file backend reuses the value already
  # in .env, so a re-render keeps the key stable.
  secret-key: { generated: true, length: 50 }
  operator-token: { generated: true, length: 32 }
{% if stack_flavor == "instance" %}
  # First-admin password. Generated into .env and consumed through YAMLCONF so the
  # IAM bootstrap reads the same declarative surface as any operator override.
  admin-password: { generated: true, length: 32 }
{% endif %}
  # The Postgres superuser password. Generated base64url (URL-safe, so it embeds in
  # the DATABASE_URL userinfo with no percent-encoding) and shared by the postgres
  # service and the django DATABASE_URL.
  db-password: { generated: true, length: 32 }

ports:
  # The operator daemon's port — services reference it as ${ports.operator}.
  operator: { value: {{ operator_port }}, export_env: ANGEE_OPERATOR_PORT }
  django: { value: {{ django_port }}, export_env: DJANGO_PORT }
{# Unconditional: the operator daemon is runtime:local in ALL modes, and without an #}
{# explicit lease the proccompose backend falls back to a shared default port — one #}
{# stack's `angee down` then tears down its neighbor's local processes. #}
  # The operator reads process_compose for the process-compose control port.
  process_compose: { value: {{ process_compose_port }}, export_env: PROCESS_COMPOSE_PORT }
{% if runtime_mode == "process" %}
  postgres: { value: {{ postgres_port }}, export_env: POSTGRES_PORT }
  redis: { value: {{ redis_port }}, export_env: REDIS_PORT }{# Optional entries share the outer endif line so disabled output stays byte-identical. #}
{% if enable_ollama %}  ollama: { value: {{ ollama_port }}, export_env: OLLAMA_PORT }{% endif %}{% endif %}
{% if runtime_mode == "docker" %}{% if stack_flavor == "framework" %}
  ui: { value: {{ ui_port }}, export_env: ANGEE_UI_PORT }
  storybook: { value: {{ storybook_port }}, export_env: STORYBOOK_PORT }
{% endif %}{% if stack_flavor == "instance" %}
  ui: { value: {{ ui_port }}, export_env: ANGEE_UI_PORT }
{% endif %}{% endif %}

# Local state angee owns and must guarantee exists before any job/container runs.
# The operator materializes these on every bring-up (StackPrepare). Subpaths are
# relative to the stack root.
persist:
{% if runtime_mode == "process" %}
  app-data: { subpath: ./data, scope: stack }
  # Host coding agent's Playwright MCP user-data-dir (docs/stack.md).
  chrome-profile: { subpath: ./data/chrome, scope: stack }
  pgdata: { subpath: ./data/pgdata, scope: stack }
{% if enable_ollama %}  ollama: { subpath: ./data/ollama, scope: stack }{% endif %}{% endif %}
{% if runtime_mode == "docker" %}
  # App media/static (ANGEE_DATA_DIR -> /app/data via the django bind mount).
  app-data: { subpath: ./data, scope: stack }{% if stack_flavor == "framework" %}
  # Playwright MCP's persistent Chromium user-data directory.
  playwright-profile: { subpath: ./data/playwright, scope: stack }{% endif %}
  # The Postgres data volume under ./data so one dir holds the instance's mutable state.
  pgdata: { subpath: ./data/pgdata, scope: stack }
{% endif %}

sources:
  app:
    kind: local
{% if runtime_mode == "process" %}
    # The application source IS this root — the project host is the stack.
    path: {{ app_source }}
{% endif %}
{% if runtime_mode == "docker" %}
    # The application source IS this root — the project is the stack.
    path: .
{% endif %}
{% if stack_flavor == "framework" %}
  framework:
    kind: local
    path: {{ framework_source }}
  # The consolidated framework source. `angee dev` materializes its clone cache
  # under sources/angee and cuts the `src` workspace's one framework worktree
  # from it. The same checkout owns core, addons, packages, examples, and templates.
  angee:
    kind: git
    repo: https://github.com/ang-ee/angee-django.git
    default_ref: main
    cache_path: sources/angee
{% if addons_profile == "full" %}
  # The full platform composition opts into the external messaging bridges.
  # Examples already live inside the consolidated angee checkout.
  angee-messaging-bridges:
    kind: git
    repo: https://github.com/ang-ee/angee-messaging-bridges.git
    default_ref: main
    cache_path: sources/angee-messaging-bridges
{% endif %}
{% if include_arp %}
  # arpee, the ARP product (arp.* consumer addons; PRIVATE repo — opt-in).
  angee-arp:
    kind: git
    repo: https://github.com/ang-ee/angee-arp.git
    default_ref: main
    cache_path: sources/angee-arp
{% endif %}
{% endif %}

{% if stack_flavor == "framework" %}
# The conventional all-source workspace: one consolidated framework worktree
# under workspaces/src/angee plus optional external-addon worktrees. `angee dev`
# cuts it from the declared sources on bring-up; the host's pyproject, addon dirs,
# and pnpm globs all point into those slots.
workspaces:
  src:
    template: workspaces/src
{% if work_state_source %}
    inputs:
      work_state_source: {{ work_state_source }}
{% endif %}
{% endif %}
{% if stack_flavor == "instance" %}
{% if framework == "source" %}
  # framework == source: run the deps-only base image and link the framework editable
  # from this checkout at container start. The checkout must exist at the stack root —
  # clone it there:  git clone https://github.com/ang-ee/angee-django sources/angee
  # It is NOT mounted separately; it lives inside the app mount at /app/sources/angee.
  framework:
    kind: local
    path: sources/angee
{% endif %}
{% endif %}

{% if runtime_mode == "process" %}
# The compose/build/serve lifecycle. JOBS run once in depends_on order; SERVICES
# stay up. `manage.py angee provision` owns the whole first-run DAG (wait-for-db,
# angee build, reconcile_permissions, makemigrations, migrate, rebac sync, resources
# load, schema) in one command, so the eight-job DAG collapses to a single job.
jobs:
  # Install the JS workspace that OWNS the project's web package, so the frontend
  # and codegen have their node_modules. Runs at source://app: pnpm walks up to the
  # nearest workspace root, so in the repo layout (project under examples/) this
  # installs the framework workspace, and in the project-at-root layout it installs
  # the project's own workspace (whose globs include the framework packages under
  # sources/angee).
  deps:
    runtime: local
    workdir: source://app
    command: ["pnpm", "install"]

  # First-run lifecycle in one command. A fresh host seeds its addon dependency
  # group empty, so the manifest-only bootstrap must fill it and uv must install it
  # before provision imports Django settings (the otherwise-unreachable fresh-host
  # deadlock). provision OWNS waiting for postgres, so it declares no depends_on.
  # --demo loads demo resources; --force-rebac makes permissions.zed authoritative.
  # Bare `uv run`: the rendered project pyproject at the stack root owns framework
  # resolution (django-angee editable, postgres extra baked into the dep) and pins
  # uv's cache to the stack-owned caches/uv — no --project, --extra, or UV_CACHE_DIR.
  provision:
    runtime: local
    workdir: source://app
    command: ["sh", "-c", "uv run python -m angee.compose.bootstrap && uv sync && exec uv run python manage.py angee provision --demo --force-rebac"]
    env:
      ANGEE_PROJECT_DIR: "."
      DATABASE_URL: "{{ database_url }}"
      YAMLCONF_SECRET_KEY: "${secret.secret-key}"

  # Refresh the operator daemon's committed SDL from the LIVE daemon; the unified
  # codegen reads this SDL, so codegen waits on this refresh.
  operator-schema:
    runtime: local
    workdir: source://app
    command: ["uv", "run", "python", "manage.py", "operator_schema"]
    env:
      ANGEE_PROJECT_DIR: "."
      DATABASE_URL: "{{ database_url }}"
      YAMLCONF_SECRET_KEY: "${secret.secret-key}"
      ANGEE_OPERATOR_URL: "{{ operator_url }}"
      ANGEE_OPERATOR_TOKEN: "${secret.operator-token}"
    depends_on: [operator, provision]

  # Regenerate this project's typed GraphQL operations from the emitted Django SDL
  # and the operator daemon SDL, after both schema sources and before Vite.
  codegen:
    runtime: local
    workdir: source://app
    command: ["pnpm", "--dir", "{{ web_path }}", "codegen"]
    depends_on: [deps, provision, operator-schema]
{% endif %}

services:
  # The operator daemon for THIS stack: it serves the console's data and runs the
  # stack. `angee operator --root .` resolves the stack root by walking up.
  operator:
    runtime: local
    command:
      - sh
      - "-c"
      # process binds 0.0.0.0 so the containerized edge reaches /edge/verify via
      # host.docker.internal; docker binds loopback (the console is host-local).
      - exec angee operator --root . --bind {{ operator_bind }} --port ${ports.operator} --token "$ANGEE_OPERATOR_TOKEN"
    env:
      ANGEE_OPERATOR_TOKEN: "${secret.operator-token}"

  # pgvector/pgvector:pg17 = stock Postgres 17 + pgvector, so a retrieval backend has
  # vector columns without a rebuild. The password comes from the db-password secret.
  postgres:
    runtime: container
    image: pgvector/pgvector:pg17
    env:
      POSTGRES_USER: angee
      POSTGRES_DB: angee
      POSTGRES_PASSWORD: "${secret.db-password}"
    mounts:
      # The generated compose file sits next to this bind's base, so the relative
      # path targets the stack's pgdata dir.
      - bind://{{ pgdata_mount }}:/var/lib/postgresql/data
{% if runtime_mode == "process" %}
    ports:
      - "${ports.postgres}:5432"
{% endif %}

  # Shared Redis for Channels fanout (DB 0) and Celery transport (DB 1).
  redis:
    runtime: container
    image: redis:7-alpine
{% if runtime_mode == "process" %}
    ports:
      - "${ports.redis}:6379"
{% endif %}

{% if runtime_mode == "process" %}{% if enable_ollama %}  # Optional shared local inference server. Models live in the stack-owned bind
  # mount and are pulled manually; no agent owns or duplicates this singleton.
  ollama:
    runtime: container
    image: ollama/ollama
    mounts:
      - bind://./data/ollama:/root/.ollama
    ports:
      - "${ports.ollama}:11434"
{% endif %}{% endif %}{% if runtime_mode == "process" %}
  # Angee overrides `runserver` to serve angee.asgi with uvicorn under Django's own
  # follow-imports autoreloader (consumer addons, base addons, framework core, editable
  # deps), never the generated runtime/ tree. Provision has already emitted runtime,
  # migrated, and loaded data, so this just serves.
  django:
    runtime: local
    workdir: source://app
    command: ["uv", "run", "python", "manage.py", "runserver", "127.0.0.1:{{ django_port }}"]
    env:
      ANGEE_PROJECT_DIR: "."
      DATABASE_URL: "{{ database_url }}"
      YAMLCONF_SECRET_KEY: "${secret.secret-key}"
      # The browser opens the daemon GraphQL same-origin via /operator/graphql.
      ANGEE_OPERATOR_GRAPHQL_ENDPOINT: "/operator/graphql"
      ANGEE_OPERATOR_URL: "{{ operator_url }}"
      ANGEE_OPERATOR_TOKEN: "${secret.operator-token}"
      # Agents run in containers, so they reach this /mcp mount through the host gateway.
      ANGEE_BUILTIN_MCP_URL: "{{ mcp_url }}"
      REDIS_URL: "{{ redis_url }}"
      CACHE_URL: "{{ redis_url }}"
      CELERY_BROKER_URL: "{{ celery_broker_url }}"
    after: [provision]
{% endif %}
{% if runtime_mode == "docker" %}{% if stack_flavor == "framework" %}
  # Framework-dev backend: sync the editable workspace, bootstrap the generated
  # addon dependency group, provision demo data and schemas, then keep Django's
  # source autoreloader as the serving owner.{% endif %}{% if stack_flavor == "instance" %}
  # Angee backend. The project mounts at /app OVER the image's /app workdir.
  # framework == source runs the deps-only base image and links the framework editable
  # from sources/angee at start (also installs psycopg since the base image bakes
  # deps WITHOUT the postgres extra; --inexact avoids pruning). The source sync first
  # makes the framework bootstrap importable; bootstrap then fills the fresh host's
  # addon group and the host sync installs it before Django settings load. framework ==
  # baked runs a code-baked runtime image and skips these syncs. provision owns the
  # first-run DAG and wait-for-db, so there is no pg-wait loop here.{% endif %}
  django:
    runtime: container
    image: {{ django_image }}
    mounts:
      - source://app:/app
      # ANGEE_DATA_DIR (/app/data) lives inside the code mount and is absent in a
      # fresh checkout; bind the stack's data dir there so media/static survive re-up.
      - bind://./data:/app/data
    workdir: /app
    env:
      ANGEE_PROJECT_DIR: /app
      DATABASE_URL: "{{ database_url }}"
      YAMLCONF_SECRET_KEY: "${secret.secret-key}"
{% if stack_flavor == "instance" %}      YAMLCONF_ANGEE_BOOTSTRAP_ADMIN_USERNAME: "admin"
      YAMLCONF_ANGEE_BOOTSTRAP_ADMIN_EMAIL: "admin@example.com"
      YAMLCONF_ANGEE_BOOTSTRAP_ADMIN_PASSWORD: "${secret.admin-password}"{% endif %}
      ANGEE_OPERATOR_GRAPHQL_ENDPOINT: "/operator/graphql"
      ANGEE_OPERATOR_URL: "{{ operator_url }}"
      ANGEE_OPERATOR_TOKEN: "${secret.operator-token}"
      ANGEE_BUILTIN_MCP_URL: "{{ mcp_url }}"
      REDIS_URL: "{{ redis_url }}"
      CACHE_URL: "{{ redis_url }}"
      CELERY_BROKER_URL: "{{ celery_broker_url }}"
      {% if uv_cache_dir %}UV_CACHE_DIR: "{{ uv_cache_dir }}"{% endif %}
{% if stack_flavor == "framework" %}    command:
      - sh
      - "-c"
      - >-
        uv sync --inexact && python -m angee.compose.bootstrap && uv sync --inexact
        && python manage.py angee provision --demo --force-rebac
        && python manage.py operator_schema
        && exec python manage.py runserver 0.0.0.0:8000{% endif %}{% if stack_flavor == "instance" %}    command:
      - sh
      - "-c"
      - >-
        {% if framework == "source" %}uv sync --frozen --inexact --extra postgres --project sources/angee && python -m angee.compose.bootstrap && uv sync --inexact && {% endif %}python manage.py angee provision --bootstrap-admin
        && CADDY_IP=$$(python -c 'import socket; print(socket.gethostbyname("caddy"))')
        && exec python -m uvicorn angee.asgi:application --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips "$$CADDY_IP"{% endif %}
    after: [postgres, redis]
{% endif %}

{# pongo2 has no list literals and takes Django-style filter args; split a string. #}
{# Core roles plus one dedicated `celery-<queue>` worker per `celery_queues` entry: a #}
{# queue worker isolates an addon's long-lived tasks (threads pool — enforces no time #}
{# limits, so queue isolation IS the protection) from the shared prefork worker, and #}
{# inherits this block's env/command owner instead of duplicating it elsewhere. The #}
{# trailing comma yields one empty item when celery_queues is blank; the guard skips it. #}
{% for role in "worker,beat,"|add:celery_queues|split:"," %}{% if role %}
  # celery {{ role }}: worker owns background bridge syncs; beat owns static framework
  # ticks; any other role is a dedicated queue worker (-Q {{ role }}).
  celery-{{ role }}:
{% if runtime_mode == "process" %}
    runtime: local
    workdir: source://app
    command: ["uv", "run", "celery", "-A", "angee.jobs.celery:app", {% if role == "beat" %}"beat"{% else %}"worker"{% endif %}{% if role != "worker" and role != "beat" %}, "-Q", "{{ role }}", "--pool", "threads", "--concurrency", "8"{% endif %}, "--loglevel=INFO"]
    env:
      ANGEE_PROJECT_DIR: "."
      DATABASE_URL: "{{ database_url }}"
      YAMLCONF_SECRET_KEY: "${secret.secret-key}"
      REDIS_URL: "{{ redis_url }}"
      CACHE_URL: "{{ redis_url }}"
      CELERY_BROKER_URL: "{{ celery_broker_url }}"
    after: [provision]
{% endif %}
{% if runtime_mode == "docker" %}
    runtime: container
    image: {{ django_image }}
    mounts:
      - source://app:/app
      - bind://./data:/app/data
    workdir: /app
    env:
      ANGEE_PROJECT_DIR: /app
      DATABASE_URL: "{{ database_url }}"
      YAMLCONF_SECRET_KEY: "${secret.secret-key}"
      ANGEE_OPERATOR_GRAPHQL_ENDPOINT: "/operator/graphql"
      ANGEE_OPERATOR_URL: "{{ operator_url }}"
      ANGEE_OPERATOR_TOKEN: "${secret.operator-token}"
      ANGEE_BUILTIN_MCP_URL: "{{ mcp_url }}"
      REDIS_URL: "{{ redis_url }}"
      CACHE_URL: "{{ redis_url }}"
      CELERY_BROKER_URL: "{{ celery_broker_url }}"
      {% if uv_cache_dir %}UV_CACHE_DIR: "{{ uv_cache_dir }}"{% endif %}
{% if stack_flavor == "framework" %}    # Sync the framework workspace (psycopg for the wait probe), wait for django's
    # migrations — that barrier also guarantees django's bootstrap projected the
    # fresh host's addon group — then sync AGAIN so this container's venv holds the
    # addon-owned deps (axes, …) before celery imports the composed settings.
    command:
      - sh
      - "-c"
      - >-
        trap 'exit 0' TERM INT; uv sync --inexact; n=0;
        until python -c "import os,psycopg; conn=psycopg.connect(os.environ['DATABASE_URL']); cur=conn.cursor(); cur.execute('select 1 from django_migrations limit 1'); row=cur.fetchone(); conn.close(); raise SystemExit(0 if row else 1)" 2>/tmp/migratewait.err; do
        n=$$((n+1));
        [ "$$n" -ge 300 ] && { echo 'django migrations not ready after 300s:' >&2; cat /tmp/migratewait.err >&2; exit 1; };
        echo "waiting for django migrations ($$n/300)..."; sleep 1;
        done;
        uv sync --inexact; exec celery -A angee.jobs.celery:app {% if role == "beat" %}beat{% else %}worker{% endif %}{% if role != "worker" and role != "beat" %} -Q {{ role }} --pool threads --concurrency 8{% endif %} --loglevel=INFO{% endif %}{% if stack_flavor == "instance" %}    # In source mode each container first links the framework so it can import psycopg,
    # then waits for django's migrations. That barrier also guarantees django projected
    # the fresh host's addon group; sync it into this container's own venv before celery.
    command:
      - sh
      - "-c"
      - >-
        trap 'exit 0' TERM INT; {% if framework == "source" %}uv sync --frozen --inexact --extra postgres --project sources/angee; {% endif %}n=0;
        until python -c "import os,psycopg; conn=psycopg.connect(os.environ['DATABASE_URL']); cur=conn.cursor(); cur.execute('select 1 from django_migrations limit 1'); row=cur.fetchone(); conn.close(); raise SystemExit(0 if row else 1)" 2>/tmp/migratewait.err; do
        n=$$((n+1));
        [ "$$n" -ge 300 ] && { echo 'django migrations not ready after 300s:' >&2; cat /tmp/migratewait.err >&2; exit 1; };
        echo "waiting for django migrations ($$n/300)..."; sleep 1;
        done;
        {% if framework == "source" %}uv sync --inexact; {% endif %}exec celery -A angee.jobs.celery:app {% if role == "beat" %}beat{% else %}worker{% endif %}{% if role != "worker" and role != "beat" %} -Q {{ role }} --pool threads --concurrency 8{% endif %} --loglevel=INFO{% endif %}
    after: [django, redis]
{% endif %}
{% endif %}{% endfor %}

{% if runtime_mode == "process" %}
  # Vite dev server for the SPA. It proxies the curated Django HTTP surfaces
  # (/graphql/, /auth/csrf/, /forms/) so browser traffic stays same-origin.
  frontend:
    runtime: local
    workdir: source://app
    command: ["pnpm", "--dir", "{{ web_path }}", "dev"]
    env:
      ANGEE_DJANGO_URL: http://127.0.0.1:{{ django_port }}
      ANGEE_UI_PORT: "{{ ui_port }}"
      # The UI proxies /operator/* to the daemon (same-origin, no CORS).
      ANGEE_OPERATOR_URL: "{{ operator_url }}"
    after: [deps, provision, django, operator, codegen]

  # Storybook component workshop (@angee/storybook): renders @angee/ui with mocked
  # fixtures. It runs in the STACK workspace — the deps job installed it as a
  # member (the pnpm-workspace globs include the monorepo's storybook package). A
  # private install inside a slot would fork dependency identities for every
  # linked framework package (two react-query = no QueryClient), so never add one.
  storybook:
    runtime: local
    workdir: source://app
    command: ["sh", "-c", "exec pnpm --filter @angee/storybook dev --no-open"]
    env:
      STORYBOOK_PORT: "{{ storybook_port }}"
    after: [deps]
{% endif %}
{% if runtime_mode == "docker" %}{% if stack_flavor == "framework" %}
  # Vite dev server for containerized framework development.
  frontend:
    runtime: container
    image: {{ node_image }}
    mounts:
      - source://app:/app
    workdir: /app
    env:
      ANGEE_DJANGO_URL: http://django:8000
      ANGEE_UI_PORT: "{{ ui_port }}"
      ANGEE_OPERATOR_URL: "{{ operator_url }}"{% if ingress_domain_value == "localhost" %}{% else %}
      ANGEE_UI_ALLOWED_HOSTS: "{{ ingress_domain_value }}"{% endif %}
    command:
      - sh
      - "-c"
      - >-
        rm -f caches/js-deps.done
        && corepack enable pnpm
        && pnpm install
        && n=0
        && until [ -s runtime/schemas/console.graphql ] && [ -s runtime/schemas/public.graphql ]; do
        n=$$((n+1));
        [ "$$n" -ge 120 ] && { echo 'runtime GraphQL schemas not ready after 120s' >&2; ls -R runtime >&2 || true; exit 1; };
        echo "waiting for runtime GraphQL schemas ($$n/120)..."; sleep 1;
        done
        && pnpm --dir {{ web_path }} codegen
        && date > caches/js-deps.done
        && exec pnpm --dir {{ web_path }} dev --host 0.0.0.0
    after: [django]{% if ingress_domain_value == "localhost" %}
    ports:
      - "${ports.ui}:{{ ui_port }}"{% else %}
    route: { port: {{ ui_port }}, path: /, auth: none }{% endif %}

  # Storybook waits for the shared pnpm install and codegen sentinel.
  storybook:
    runtime: container
    image: {{ node_image }}
    mounts:
      - source://app:/app
    workdir: /app
    env:
      STORYBOOK_PORT: "{{ storybook_port }}"
    command:
      - sh
      - "-c"
      - >-
        corepack enable pnpm;
        n=0;
        until [ -s caches/js-deps.done ]; do
        n=$$((n+1));
        [ "$$n" -ge 300 ] && { echo 'JS dependencies not ready after 300s' >&2; exit 1; };
        echo "waiting for JS dependencies ($$n/300)..."; sleep 1;
        done;
        exec pnpm --filter @angee/storybook dev --no-open --host 0.0.0.0
    after: [frontend]
    ports:
      - "${ports.storybook}:{{ storybook_port }}"

  # Remote Playwright browser server using the framework workspace's locked runner.
  playwright-server:
    runtime: container
    image: {{ playwright_image }}
    mounts:
      - source://app:/app
    workdir: /app
    command:
      - sh
      - "-c"
      - >-
        corepack enable pnpm;
        n=0;
        until [ -s caches/js-deps.done ]; do
        n=$$((n+1));
        [ "$$n" -ge 300 ] && { echo 'JS dependencies not ready after 300s' >&2; exit 1; };
        echo "waiting for JS dependencies ($$n/300)..."; sleep 1;
        done;
        exec pnpm --filter @angee/e2e exec playwright run-server --host 0.0.0.0 --port 3100
    after: [frontend]
    route: { port: 3100, auth: forward }

  # Persistent headless Playwright MCP server behind forward-auth ingress.
  playwright-mcp:
    runtime: container
    image: {{ playwright_mcp_image }}
    mounts:
      - bind://./data/playwright:/data/profile
    # --allowed-hosts "*": requests arrive through the edge with the ingress domain as
    # Host; the MCP's own host check is a DNS-rebinding guard for unauthenticated local
    # servers, and THIS endpoint is route-only (never host-published) behind the
    # operator's forward-auth, so the edge bearer is the real gate.
    command: ["--headless", "--browser", "chromium", "--no-sandbox", "--host", "0.0.0.0", "--port", "8931", "--allowed-hosts", "*", "--user-data-dir", "/data/profile"]
    after: [frontend]
    route: { port: 8931, auth: forward }
{% endif %}{% endif %}{% if runtime_mode == "docker" %}{% if stack_flavor == "instance" %}
  # Static frontend build for Caddy ingress. A compose-visible service (not a job)
  # because Caddy depends on it in the container graph. The @angee/* packages are baked
  # into the web image; in source mode the first node -e overlays each package's src/
  # from the monorepo packages and addon sources so the built SPA reflects
  # local source JS (a no-op in baked mode, where the checkouts are absent). The second
  # node -e symlinks each package into the mounted project's node_modules before
  # codegen/build resolves runtime/web/app.ts.
  frontend-build:
    runtime: container
    image: {{ web_image }}
    mounts:
      - source://app:/opt/angee-web/project
    workdir: /opt/angee-web/project/{{ web_path }}
    command:
      - sh
      - "-c"
      - >-
        cd /opt/angee-web
        && printf 'packages:\n  - "packages/*"\n  - "project/{{ web_path }}"\n' > pnpm-workspace.yaml
        && node -e 'const fs=require("node:fs"); const path=require("node:path"); const root="/opt/angee-web"; const packageDirs=[]; const addImmediate=(base)=>{ if (!fs.existsSync(base)) return; for (const dir of fs.readdirSync(base)) { const source=path.join(base,dir); if (fs.existsSync(path.join(source,"package.json"))) packageDirs.push(source); } }; const addAddonWeb=(base)=>{ if (!fs.existsSync(base)) return; for (const dir of fs.readdirSync(base)) { const source=path.join(base,dir,"web"); if (fs.existsSync(path.join(source,"package.json"))) packageDirs.push(source); } }; addImmediate(path.join(root,"project/sources/angee/packages")); addAddonWeb(path.join(root,"project/sources/angee/addons/angee")); addAddonWeb(path.join(root,"project/sources/angee-messaging-bridges/addons/angee")); for (const source of packageDirs) { const manifest=JSON.parse(fs.readFileSync(path.join(source,"package.json"),"utf8")); if (typeof manifest.name !== "string" || !manifest.name.startsWith("@angee/")) continue; const target=path.join(root,"packages",manifest.name.slice("@angee/".length)); const srcDir=path.join(source,"src"); const dstDir=path.join(target,"src"); if (!fs.existsSync(srcDir) || !fs.existsSync(target)) continue; fs.rmSync(dstDir,{recursive:true,force:true}); fs.cpSync(srcDir,dstDir,{recursive:true,force:true}); }'
        && pnpm install
        && node -e 'const fs=require("node:fs"); const path=require("node:path"); const root="/opt/angee-web"; const packages=path.join(root,"packages"); const scope=path.join(root,"project/{{ web_path }}/node_modules/@angee"); fs.mkdirSync(scope,{recursive:true}); for (const dir of fs.readdirSync(packages)) { const target=path.join(packages,dir); const packageJson=path.join(target,"package.json"); if (!fs.existsSync(packageJson)) continue; const manifest=JSON.parse(fs.readFileSync(packageJson,"utf8")); if (typeof manifest.name !== "string" || !manifest.name.startsWith("@angee/")) continue; const link=path.join(scope,manifest.name.slice("@angee/".length)); if (fs.existsSync(link)) continue; try { fs.unlinkSync(link); } catch (error) { if (error.code !== "ENOENT") throw error; } fs.symlinkSync(path.relative(scope,target),link,"dir"); }'
        && n=0
        && until [ -s project/runtime/schemas/console.graphql ] && [ -s project/runtime/schemas/public.graphql ]; do
        n=$$((n+1));
        [ "$$n" -ge 120 ] && { echo 'runtime GraphQL schemas not ready after 120s' >&2; ls -R project/runtime >&2 || true; exit 1; };
        echo "waiting for runtime GraphQL schemas ($$n/120)..."; sleep 1;
        done
        && cd project/{{ web_path }}
        && pnpm codegen
        && pnpm build
        && echo 'frontend build complete; holding for caddy_static dev stack'
        && exec tail -f /dev/null
    after: [django]

  # Browser-facing ingress. Caddy serves the built SPA and proxies only backend
  # endpoints over internal routes; SPA pages fall through to index.html.
  caddy:
    runtime: container
    image: {{ caddy_image }}
    mounts:
      - source://app:/srv/project
    command:
      - sh
      - "-c"
      - |-
        n=0
        until [ -s /srv/project/{{ web_path }}/dist/index.html ]; do
          n=$$((n+1))
          [ "$$n" -ge 180 ] && { echo 'frontend build output not ready after 180s' >&2; ls -R /srv/project/{{ web_path }}/dist >&2 || true; exit 1; }
          echo "waiting for frontend build output ($$n/180)..."
          sleep 1
        done
        cat >/etc/caddy/Caddyfile <<'CADDY'
        :80 {
          encode zstd gzip

          @django path /graphql/* /auth/csrf /auth/csrf/ /forms/* /storage/upload /storage/upload/* /storage/download /storage/download/* /admin/* /static/* /media/*
          handle @django {
            reverse_proxy django:8000
          }

          @operator_graphql path /operator/graphql /operator/graphql/*
          handle @operator_graphql {
            uri strip_prefix /operator
            reverse_proxy host.docker.internal:${ports.operator}
          }

          @operator_logs path_regexp operator_logs ^/operator/services/[^/]+/logs/stream$
          handle @operator_logs {
            uri strip_prefix /operator
            reverse_proxy host.docker.internal:${ports.operator}
          }

          handle {
            root * /srv/project/{{ web_path }}/dist
            try_files {path} /index.html
            file_server
          }
        }
        CADDY
        exec caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
    after: [django, frontend-build]
    ports:
      - "{{ ui_port }}:80"
{% endif %}{% endif %}
