{# Shared stack manifest body for BOTH stack templates. NOTE: pongo2 (the operator's #}
{# renderer) only supports SINGLE-LINE jinja comments — never span lines with one {#. #}
{# The two thin wrappers each set `stack_flavor`, `runtime_mode`, and address #}
{# variables in a `{% set %}` header, then include this one file at column 0. #}
{# Everything below is the single source of truth for the manifest. stack_flavor #}
{# selects framework-dev versus self-contained instance structure; runtime_mode #}
{# selects process versus container execution where those genuinely differ. #}
{# framework = stacks/dev — owns ingress, the framework source roster, and src workspace. #}
{#   Both runtimes expose one-shot preparation as jobs in the dependency graph. #}
{#   Both modes run directly against the framework workspace's source checkouts. #}
{# instance = stacks/local — owns bootstrap-admin secrets and the static frontend. #}
{#   Its docker runtime uses jobs over the compose network, with Caddy serving the SPA. #}
{# Wrapper-provided variables: stack_flavor, runtime_mode, postgres_user/_db/_address and redis_address/_db/_broker_db #}
{# (the body composes database_url, redis_url, and celery_broker_url from them), operator_url, #}
{# mcp_url, operator_bind, pgdata_mount, (process only) app_source; framework_source — plus the dev #}
{# copier inputs postgres_mode and redis_mode (unset for local), addons_profile, work_state_source, and (both templates) sentry_dsn / sentry_web_dsn. #}
{# Process mode always renders development, even if a caller bypasses the Copier validator. #}
{% set effective_serve_mode = "development" %}{% if runtime_mode == "docker" %}{% set effective_serve_mode = serve_mode %}{% endif %}{% set database_url = "postgres://"|add:postgres_user|add:":${secret.db-password}@"|add:postgres_address|add:"/"|add:postgres_db %}{% set redis_url = "redis://"|add:redis_address|add:"/"|add:redis_db %}{% set celery_broker_url = "redis://"|add:redis_address|add:"/"|add:redis_broker_db %}
version: 1
kind: stack
{% if stack_flavor == "framework" %}
name: {{ project_name }}
{% endif %}
{% if stack_flavor == "instance" %}
name: {{ instance_name }}
{% endif %}

template:
{% if stack_flavor == "framework" %}
  active: stacks/dev
{% endif %}
{% if stack_flavor == "instance" %}
  active: {{ _src_path }}
{% endif %}
  # The PROJECT owns the canonical .copier-answers.yml (dev is chained under a
  # workspace, local under the projects/web host); the stack keeps its OWN answers
  # file so it never clobbers the project's.
  answers_file: .copier-answers.stack.yml

{% if stack_flavor == "framework" %}
# Edge ingress. The operator's central Caddy fronts every service that declares a
# `route:` block (e.g. the agent chat WebSocket) and forward-auths each upgrade
# against the operator's /edge/verify. Without an `ingress.type: caddy` stack the
# operator treats routed services as unrouted and `agentChatEndpoint` can't hand
# the browser a reachable URL.
#
{% if ingress_domain_value == "localhost" %}# Dev uses `routing: path` + `tls: off`: one shared host with a `/<service>/` prefix
# per agent (no per-agent subdomain/DNS), and plain ws. `localhost` always resolves,
# so a freshly provisioned agent is reachable at ws://localhost:<edge_port>/<service>/
# with zero DNS or cert setup.{% else %}
# With a public DNS name, Caddy serves container routes over automatic TLS on host
# ports 443/80. Docker mode routes the Vite UX at `/`; process mode keeps its local
# frontend on ui_port because runtime-local services cannot be routed. Its routed
# container services still use TLS; the Playwright routes exist only in Docker mode.{% endif %}
ingress:
  type: caddy
  routing: path
  tls: {% if ingress_domain_value == "localhost" %}"off"   # quoted: bare YAML `off` is boolean false; the operator wants the string{% else %}auto{% endif %}
  domain: {{ ingress_domain_value }}
{% if ingress_aliases %}  # Further host names served as the same site, each with its own certificate.
  aliases: [{{ ingress_aliases }}]
{% endif %}{% if ingress_domain_value == "localhost" %}{# edge_port applies only in localhost mode; automatic TLS pins host ports 443/80. #}  # Host port the edge publishes. 80 for the base stack; a workspace leases a distinct
  # value (operator.port_pool.edge) so parallel stacks on one host don't all fight for :80.
  port: {{ edge_port }}{% endif %}
  # The edge runs as a container; this dev stack's operator is `runtime: local`, so
  # forward_auth must reach it on the host instead of the default `operator:9000`.
{% if runtime_mode == "docker" %}  verify: operator:9000  # the operator container, resolved over the compose default network{% else %}  verify: host.docker.internal:{{ operator_port }}{% endif %}
{% endif %}

# The operator daemon owns stack-secret management. The console bearer is a
# generated secret shared by the daemon (--token) and Django (ANGEE_OPERATOR_TOKEN),
# so neither side hardcodes it. The docker-compose backend loads ./.env via
# `--env-file` unconditionally, so the env-file backend must write it before bring-up.
secrets_backend:
  type: env-file
  path: .env

secrets:
  # The instance's Django SECRET_KEY, in BOTH modes: encrypted-at-rest fields
  # (angee.base EncryptedField — e.g. integrate.oauthclient.client_secret) derive
  # their Fernet key from it, so switching a stack between process and docker
  # rendering must NEVER rotate it. The env-file backend reuses the value already
  # in .env, so a re-render keeps the key stable.
  secret-key: { generated: true, length: 50 }
  operator-token: { generated: true, length: 32 }
{% if stack_flavor == "instance" %}
  # First-admin password. Generated into .env and consumed through YAMLCONF so the
  # IAM bootstrap reads the same declarative surface as any operator override.
  admin-password: { generated: true, length: 32 }
{% endif %}
{% if postgres_mode == "external" %}  # Must equal the external server's password for the postgres_user role ({{ postgres_user }}).
  db-password: { required: true }
{% else %}  # The Postgres superuser password. Generated base64url (URL-safe, so it embeds in
  # the DATABASE_URL userinfo with no percent-encoding) and shared by the postgres
  # service and the django DATABASE_URL.
  db-password: { generated: true, length: 32 }{% endif %}

ports:
  # The operator daemon's port — services reference it as ${ports.operator}.
  operator: { value: {{ operator_port }}, export_env: ANGEE_OPERATOR_PORT }
  django: { value: {{ django_port }}, export_env: DJANGO_PORT }
{# Reserve the local supervisor port even when a stack currently uses Docker: without #}
{# an explicit lease the proccompose backend falls back to a shared port — one #}
{# stack's `angee down` then tears down its neighbor's local processes. #}
  # The operator reads process_compose for the process-compose control port.
  process_compose: { value: {{ process_compose_port }}, export_env: PROCESS_COMPOSE_PORT }
{% if runtime_mode == "process" %}
{% if postgres_mode == "external" %}{% else %}  postgres: { value: {{ postgres_port }}, export_env: POSTGRES_PORT }
{% endif %}{% if redis_mode == "external" %}{% else %}  redis: { value: {{ redis_port }}, export_env: REDIS_PORT }{# Optional entries share the outer endif line so disabled output stays byte-identical. #}
{% endif %}{% if enable_ollama %}  ollama: { value: {{ ollama_port }}, export_env: OLLAMA_PORT }{% endif %}{% endif %}
{% if runtime_mode == "docker" %}{% if stack_flavor == "framework" %}
  ui: { value: {{ ui_port }}, export_env: ANGEE_UI_PORT }
  storybook: { value: {{ storybook_port }}, export_env: STORYBOOK_PORT }
{% endif %}{% if stack_flavor == "instance" %}
  ui: { value: {{ ui_port }}, export_env: ANGEE_UI_PORT }
{% endif %}{% endif %}

# Local state angee owns and must guarantee exists before any job/container runs.
# The operator materializes these on every bring-up (StackPrepare). Subpaths are
# relative to the stack root.
persist:
{% if runtime_mode == "process" %}
  app-data: { subpath: ./data, scope: stack }
  # Host coding agent's Playwright MCP user-data-dir (docs/stack.md).
  chrome-profile: { subpath: ./data/chrome, scope: stack }
{% if postgres_mode == "external" %}{% else %}  pgdata: { subpath: ./data/pgdata, scope: stack }
{% endif %}{% if enable_ollama %}  ollama: { subpath: ./data/ollama, scope: stack }{% endif %}{% endif %}
{% if runtime_mode == "docker" %}
  # App media/static (ANGEE_DATA_DIR -> /app/data via the django bind mount).
  app-data: { subpath: ./data, scope: stack }{% if stack_flavor == "framework" %}
  # Playwright MCP's persistent Chromium user-data directory.
  playwright-profile: { subpath: ./data/playwright, scope: stack }{% endif %}
{% if postgres_mode == "external" %}{% else %}  # The Postgres data volume under ./data so one dir holds the instance's mutable state.
  pgdata: { subpath: ./data/pgdata, scope: stack }
{% endif %}{% endif %}

sources:
  app:
    kind: local
{% if runtime_mode == "process" %}
    # The application source IS this root — the project host is the stack.
    path: {{ app_source }}
{% endif %}
{% if runtime_mode == "docker" %}
    # The application source IS this root — the project is the stack.
    path: .
{% endif %}
{% if stack_flavor == "framework" %}
  framework:
    kind: local
    path: {{ framework_source }}
  # The consolidated framework source. `angee dev` materializes its clone cache
  # and cuts the `src` workspace's one framework worktree from it. The same
  # checkout owns core, addons, packages, examples, and templates. With
  # sources_home set, every git cache lives under that machine-wide directory,
  # named after its repository, and is shared by every stack on the machine;
  # empty keeps the per-stack cache under sources/.
  angee:
    kind: git
    repo: https://github.com/ang-ee/angee-django.git
    default_ref: main
    cache_path: {% if sources_home %}{{ sources_home }}/angee-django{% else %}sources/angee{% endif %}
{% if addons_profile == "full" %}
  # The full platform composition opts into the external messaging bridges.
  # Examples already live inside the consolidated angee checkout.
  angee-messaging-bridges:
    kind: git
    repo: https://github.com/ang-ee/angee-messaging-bridges.git
    default_ref: main
    cache_path: {% if sources_home %}{{ sources_home }}/angee-messaging-bridges{% else %}sources/angee-messaging-bridges{% endif %}
{% endif %}
{% if include_arp %}
  # arpee, the ARP product (arp.* consumer addons; PRIVATE repo — opt-in).
  angee-arp:
    kind: git
    repo: {{ arp_repo }}
    default_ref: main
    cache_path: {% if sources_home %}{{ sources_home }}/angee-arp{% else %}sources/angee-arp{% endif %}
{% endif %}
{% if work_state_source and work_state_repo %}
  # The private work-state repo (plans, notes, memory, handovers) the src workspace
  # binds at `.work/`. Declared only when both the name and the repo location are set;
  # a clean-machine stack leaves both empty and renders no work-state source.
  {{ work_state_source }}:
    kind: git
    repo: {{ work_state_repo }}
    default_ref: {{ work_state_ref }}
    cache_path: {% if sources_home %}{{ sources_home }}/{{ work_state_source }}{% else %}sources/work/{{ work_state_source }}{% endif %}
{% endif %}
{% endif %}

{% if stack_flavor == "framework" %}
# Stack-level input defaults for every workspace cut from the src template (an
# explicit --input still wins). branch_prefix makes the stack name the namespace
# of every workspace branch, `<stack>/<workspace>`, so stacks sharing one cache
# or one fork never collide; shared work uses an explicit `feature/<topic>`
# branch on the workspace instead. work_state_source binds the private work-state
# slot at `.work/` without repeating the input (`--input work_state_source=` opts
# out); a clean-machine stack leaves it empty and binds nothing.
workspace_defaults:
  workspaces/src:
    inputs:
      branch_prefix: {{ project_name }}
{% if work_state_source %}
      work_state_source: {{ work_state_source }}
{% endif %}
# The conventional all-source workspace: one consolidated framework worktree
# under workspaces/src/angee plus optional external-addon worktrees. `angee dev`
# cuts it from the declared sources on bring-up; the host's pyproject, addon dirs,
# and pnpm globs all point into those slots.
workspaces:
  src:
    template: workspaces/src
{% if work_state_source %}
    inputs:
      work_state_source: {{ work_state_source }}
{% endif %}
{% endif %}
{% if stack_flavor == "instance" %}
{% if framework == "source" %}
  # framework == source: run the deps-only base image and link the framework editable
  # from this checkout at container start. The checkout must exist at the stack root —
  # clone it there:  git clone https://github.com/ang-ee/angee-django sources/angee
  # It is NOT mounted separately; it lives inside the app mount at /app/sources/angee.
  framework:
    kind: local
    path: sources/angee
{% endif %}
{% endif %}

{# The template chooses the entry job; the operator follows only declared edges. #}
{% set restart_job = "deps" %}{% if stack_flavor == "instance" %}{% set restart_job = "provision" %}{% endif %}
{% set python_sync = "" %}{% set python_bootstrap = "" %}
{% if runtime_mode == "docker" %}{% if stack_flavor == "framework" %}{% set python_sync = "uv sync --inexact && " %}{% set python_bootstrap = "uv sync --inexact && python -m angee.compose.bootstrap && uv sync --inexact && " %}{% else %}{% if framework == "source" %}{% set python_sync = "uv sync --frozen --inexact --extra postgres --project sources/angee && uv sync --inexact && " %}{% set python_bootstrap = "uv sync --frozen --inexact --extra postgres --project sources/angee && python -m angee.compose.bootstrap && uv sync --inexact && " %}{% endif %}{% endif %}{% endif %}

# Jobs finish successfully before their dependents start. Re-running the entry
# job with chained_restart applies this same graph to the running application.
# `manage.py angee provision` owns runtime preparation and the fresh
# post-build process boundary.
jobs:
{% if stack_flavor == "framework" %}
  # Install at the host's JS workspace owner, including its addon packages.
  deps:
{% if runtime_mode == "process" %}    runtime: local
    workdir: source://app
    command: ["pnpm", "install"]
{% else %}    runtime: container
    image: {{ node_image }}
    mounts:
      - source://app:/app
    workdir: /app
    command: ["sh", "-c", "corepack enable pnpm && exec pnpm install"]
{% endif %}{% endif %}

  # Bootstrap the addon dependency group before Django imports, then let the
  # provision command own its lifecycle and database wait in a fresh interpreter.
  provision:
{% include "../_shared/python-runtime.yaml.jinja" with pool_for_django="" %}
{% if stack_flavor == "instance" %}      YAMLCONF_ANGEE_BOOTSTRAP_ADMIN_USERNAME: "admin"
      YAMLCONF_ANGEE_BOOTSTRAP_ADMIN_EMAIL: "admin@example.com"
      YAMLCONF_ANGEE_BOOTSTRAP_ADMIN_PASSWORD: "${secret.admin-password}"
{% endif %}{% if runtime_mode == "process" %}    command: ["sh", "-c", "uv run python -m angee.compose.bootstrap && uv sync && exec uv run python manage.py angee provision --demo --force-rebac"]
    depends_on: [deps, operator]
{% else %}    command:
      - sh
      - "-c"
      - >-
        {{ python_bootstrap }}exec python manage.py angee provision {% if stack_flavor == "framework" %}--demo --force-rebac{% else %}--bootstrap-admin{% endif %}
    depends_on: [{% if postgres_mode == "external" %}{% else %}postgres, {% endif %}operator{% if stack_flavor == "framework" %}, deps{% endif %}]
{% endif %}

  # Codegen consumes both the provisioned Django SDL and this live daemon SDL.
  operator-schema:
{% include "../_shared/python-runtime.yaml.jinja" with pool_for_django="" %}
{% if runtime_mode == "process" %}    command: ["uv", "run", "python", "manage.py", "operator_schema"]
{% else %}    command: ["sh", "-c", "{{ python_sync }}exec python manage.py operator_schema"]
{% endif %}    depends_on: [operator, provision]

{% if stack_flavor == "framework" %}
  codegen:
{% if runtime_mode == "process" %}    runtime: local
    workdir: source://app
    command: ["pnpm", "--dir", "{{ web_path }}", "codegen"]
{% else %}    runtime: container
    image: {{ node_image }}
    mounts:
      - source://app:/app
    workdir: /app
    command: ["sh", "-c", "corepack enable pnpm && exec pnpm --dir {{ web_path }} codegen"]
{% endif %}    depends_on: [deps, provision, operator-schema]{% if effective_serve_mode == "production" %}
  frontend-build:
    runtime: container
    image: {{ node_image }}
    mounts:
      - source://app:/app
    workdir: /app
    command: ["sh", "-c", "corepack enable pnpm && exec pnpm --dir {{ web_path }} build"]{% if sentry_web_dsn %}
    env:
      VITE_SENTRY_DSN: "{{ sentry_web_dsn }}"
      VITE_SENTRY_ENVIRONMENT: "{{ effective_serve_mode }}"{% endif %}
    depends_on: [codegen]
{% endif %}
{% else %}
  # The web image owns its package overlay, install, codegen, and static build.
  frontend-build:
    runtime: container
    image: {{ web_image }}
    mounts:
      - source://app:/opt/angee-web/project
    workdir: /opt/angee-web/project/{{ web_path }}
    command:
      - sh
      - "-c"
      - >-
        cd /opt/angee-web
        && printf 'packages:\n  - "packages/*"\n  - "project/{{ web_path }}"\n' > pnpm-workspace.yaml
        && node -e 'const fs=require("node:fs"); const path=require("node:path"); const root="/opt/angee-web"; const packageDirs=[]; const addImmediate=(base)=>{ if (!fs.existsSync(base)) return; for (const dir of fs.readdirSync(base)) { const source=path.join(base,dir); if (fs.existsSync(path.join(source,"package.json"))) packageDirs.push(source); } }; const addAddonWeb=(base)=>{ if (!fs.existsSync(base)) return; for (const dir of fs.readdirSync(base)) { const source=path.join(base,dir,"web"); if (fs.existsSync(path.join(source,"package.json"))) packageDirs.push(source); } }; addImmediate(path.join(root,"project/sources/angee/packages")); addAddonWeb(path.join(root,"project/sources/angee/addons/angee")); addAddonWeb(path.join(root,"project/sources/angee-messaging-bridges/addons/angee")); for (const source of packageDirs) { const manifest=JSON.parse(fs.readFileSync(path.join(source,"package.json"),"utf8")); if (typeof manifest.name !== "string" || !manifest.name.startsWith("@angee/")) continue; const target=path.join(root,"packages",manifest.name.slice("@angee/".length)); const srcDir=path.join(source,"src"); const dstDir=path.join(target,"src"); if (!fs.existsSync(srcDir) || !fs.existsSync(target)) continue; fs.rmSync(dstDir,{recursive:true,force:true}); fs.cpSync(srcDir,dstDir,{recursive:true,force:true}); }'
        && pnpm install
        && node -e 'const fs=require("node:fs"); const path=require("node:path"); const root="/opt/angee-web"; const packages=path.join(root,"packages"); const scope=path.join(root,"project/{{ web_path }}/node_modules/@angee"); fs.mkdirSync(scope,{recursive:true}); for (const dir of fs.readdirSync(packages)) { const target=path.join(packages,dir); const packageJson=path.join(target,"package.json"); if (!fs.existsSync(packageJson)) continue; const manifest=JSON.parse(fs.readFileSync(packageJson,"utf8")); if (typeof manifest.name !== "string" || !manifest.name.startsWith("@angee/")) continue; const link=path.join(scope,manifest.name.slice("@angee/".length)); if (fs.existsSync(link)) continue; try { fs.unlinkSync(link); } catch (error) { if (error.code !== "ENOENT") throw error; } fs.symlinkSync(path.relative(scope,target),link,"dir"); }'
        && cd project/{{ web_path }}
        && pnpm codegen
        && pnpm build{% if sentry_web_dsn %}
    env:
      VITE_SENTRY_DSN: "{{ sentry_web_dsn }}"
      VITE_SENTRY_ENVIRONMENT: "{{ effective_serve_mode }}"{% endif %}
    depends_on: [provision, operator-schema]

{% endif %}

services:
  # The operator daemon for THIS stack: it serves the console's data and runs the
  # stack. `angee operator --root .` resolves the stack root by walking up.
  operator:
{% if runtime_mode == "docker" %}{# Docker mode: the daemon is a container over the docker socket. The stack root #}
{# mounts at its host-identical path (${stack.root}) so the compose files it writes #}
{# and the sources/workspaces it manages agree with the host daemon; the token rides #}
{# argv via compose env-file interpolation (same exposure as the shell-expanded local #}
{# form). A docker-mode host needs only the angee CLI, docker, and git. With #}
{# operator_home, the daemon's user gets that literal HOME (never ${HOME}: compose #}
{# would interpolate the operator container's own) and reads its .ssh read-only at #}
{# the same path, so git over SSH resolves keys, aliases and known_hosts as on the host. #}
    runtime: container
    image: {{ operator_image }}
    command: ["--root", "${stack.root}", "--bind", "0.0.0.0", "--port", "9000", "--token", "${secret.operator-token}"{% if effective_serve_mode == "production" %}, "--allowed-origin", "{% if ingress_domain_value == "localhost" %}http://localhost:{{ ui_port }}{% else %}https://{{ ingress_domain_value }}{% endif %}"{% endif %}]
    mounts:
      - "bind://.:${stack.root}"
      - "bind:///var/run/docker.sock:/var/run/docker.sock"
{% if operator_home %}      - "bind://{{ operator_home }}/.ssh:{{ operator_home }}/.ssh:ro"
{% endif %}    ports:
      - "{% if operator_bind == "127.0.0.1" %}127.0.0.1:{% endif %}${ports.operator}:9000"
{% if operator_home %}    env:
      HOME: "{{ operator_home }}"
{% endif %}{% endif %}{% if runtime_mode == "process" %}    runtime: local
    command:
      - sh
      - "-c"
      # process binds 0.0.0.0 so the containerized edge reaches /edge/verify via
      # host.docker.internal; docker binds loopback (the console is host-local).
      - exec angee operator --root . --bind {{ operator_bind }} --port ${ports.operator} --token "$ANGEE_OPERATOR_TOKEN"
    env:
      ANGEE_OPERATOR_TOKEN: "${secret.operator-token}"
{% endif %}
{% if postgres_mode == "external" %}{% else %}  # pgvector/pgvector:pg17 = stock Postgres 17 + pgvector, so a retrieval backend has
  # vector columns without a rebuild. The password comes from the db-password secret.
  postgres:
    runtime: container
    image: pgvector/pgvector:pg17
    env:
      POSTGRES_USER: {{ postgres_user }}
      POSTGRES_DB: {{ postgres_db }}
      POSTGRES_PASSWORD: "${secret.db-password}"
    mounts:
      # The generated compose file sits next to this bind's base, so the relative
      # path targets the stack's pgdata dir.
      - bind://{{ pgdata_mount }}:/var/lib/postgresql/data
{% if runtime_mode == "process" %}
    ports:
      - "${ports.postgres}:5432"
{% endif %}

{% endif %}{% if redis_mode == "external" %}{% else %}  # Shared Redis for Channels fanout (DB {{ redis_db }}) and Celery transport (DB {{ redis_broker_db }}).
  redis:
    runtime: container
    image: redis:7-alpine
{% if runtime_mode == "process" %}
    ports:
      - "${ports.redis}:6379"
{% endif %}

{% endif %}{% if runtime_mode == "process" %}{% if enable_ollama %}  # Optional shared local inference server. Models live in the stack-owned bind
  # mount and are pulled manually; no agent owns or duplicates this singleton.
  ollama:
    runtime: container
    image: ollama/ollama
    mounts:
      - bind://./data/ollama:/root/.ollama
    ports:
      - "${ports.ollama}:11434"
{% endif %}{% endif %}
  # Each container syncs its own venv; the provision job already prepared the host.
  django:
{% include "../_shared/python-runtime.yaml.jinja" with pool_for_django="true" %}
{% if runtime_mode == "process" %}    command: ["uv", "run", "python", "manage.py", "runserver", "127.0.0.1:{{ django_port }}"]
    ready:
      tcp: { port: {{ django_port }} }
{% else %}    # Trust the connected Compose network, not a frontend IP that can change
    # independently when the frontend container restarts.
    command:
      - sh
      - "-c"
      - >-
        {{ python_sync }}{% if stack_flavor == "framework" and effective_serve_mode == "development" %}exec python manage.py runserver 0.0.0.0:8000{% else %}TRUSTED_PROXY_CIDR=$$(python -c 'import ipaddress as ip, socket; peer = ip.ip_address(socket.gethostbyname("{% if stack_flavor == "framework" %}frontend{% else %}caddy{% endif %}")); routes = (line.split() for line in open("/proc/net/route").read().splitlines()[1:]); networks = (ip.ip_network((ip.IPv4Address(int.from_bytes(bytes.fromhex(row[1]), "little")), int.from_bytes(bytes.fromhex(row[7]), "little").bit_count()), strict=False) for row in routes if row[7] != "00000000"); print(next(str(network) for network in networks if peer in network))')
        && exec python manage.py serve --host 0.0.0.0 --port 8000 --forwarded-allow-ips "$$TRUSTED_PROXY_CIDR" --workers {% if effective_serve_mode == "production" %}{{ serve_workers }} --production{% else %}1{% endif %}{% endif %}
    ready:
      cmd: ["python", "-c", "import socket; socket.create_connection(('127.0.0.1', 8000), 1).close()"]
{% endif %}      interval: 5s
      timeout: 3s
      start_period: 30s
      retries: 180
    after: [provision{% if stack_flavor == "instance" %}, caddy{% else %}{% if effective_serve_mode == "production" %}, frontend{% endif %}{% endif %}]

{# pongo2 has no list literals and takes Django-style filter args; split a string. #}
{# The shared worker plus one dedicated `celery-<queue>` worker per `celery_queues` entry: #}
{# a queue worker isolates an addon's long-lived tasks (threads pool — enforces no time #}
{# limits, so queue isolation IS the protection) from the shared prefork worker, and #}
{# inherits this block's env/command owner instead of duplicating it elsewhere. The shared #}
{# worker embeds beat (`--beat`): never scale it, beat has no leader lock (one scheduler per #}
{# stack); beat's schedule lives in the database. The #}
{# trailing comma yields one empty item when celery_queues is blank; the guard skips it. #}
{% for role in "worker,"|add:celery_queues|split:"," %}{% if role %}
  # Dedicated queue workers retain their own pool and concurrency policy.
  celery-{{ role }}:
{% include "../_shared/python-runtime.yaml.jinja" with pool_for_django="" %}
    # Let Celery finish a warm shutdown, then bound native supervisor updates.
    stop_grace_period: 30s
{% if runtime_mode == "process" %}    command: ["uv", "run", "celery", "-A", "angee.jobs.celery:app", "worker", {% if role == "worker" %}"--beat"{% else %}"-Q", "{{ role }}", "--pool", "threads", "--concurrency", "8"{% endif %}, "--loglevel=INFO"]
    after: [provision]
{% else %}    command:
      - sh
      - "-c"
      - >-
        {{ python_sync }}exec celery -A angee.jobs.celery:app worker {% if role == "worker" %}--beat{% else %}-Q {{ role }} --pool threads --concurrency 8{% endif %} --loglevel=INFO
    after: [provision{% if redis_mode == "external" %}{% else %}, redis{% endif %}]
{% endif %}
{% endif %}{% endfor %}

{% if runtime_mode == "process" and stack_flavor == "framework" %}
  # Vite dev server for the SPA. It proxies the curated Django HTTP surfaces
  # (/graphql/, /auth/csrf/, /forms/) so browser traffic stays same-origin.
  frontend:
    runtime: local
    workdir: source://app
    command: ["pnpm", "--dir", "{{ web_path }}", "dev"]
    env:
      ANGEE_DJANGO_URL: http://127.0.0.1:{{ django_port }}
      ANGEE_UI_PORT: "{{ ui_port }}"
      # The UI proxies /operator/* to the daemon (same-origin, no CORS).
      ANGEE_OPERATOR_URL: "{{ operator_url }}"{% if sentry_web_dsn %}
      VITE_SENTRY_DSN: "{{ sentry_web_dsn }}"
      VITE_SENTRY_ENVIRONMENT: "{{ effective_serve_mode }}"{% endif %}
    ready:
      http: { port: {{ ui_port }}, path: / }
      interval: 5s
      timeout: 3s
      start_period: 30s
      retries: 180
    after: [django, operator, codegen]

  # Storybook component workshop (@angee/storybook): renders @angee/ui with mocked
  # fixtures. It runs in the STACK workspace — the deps job installed it as a
  # member (the pnpm-workspace globs include the monorepo's storybook package). A
  # private install inside a slot would fork dependency identities for every
  # linked framework package (two react-query = no QueryClient), so never add one.
  storybook:
    runtime: local
    workdir: source://app
    command: ["sh", "-c", "exec pnpm --filter @angee/storybook dev --no-open"]
    env:
      STORYBOOK_PORT: "{{ storybook_port }}"
    after: [deps]
{% endif %}
{% if runtime_mode == "docker" %}{% if stack_flavor == "framework" %}{% if effective_serve_mode == "development" %}
  # Vite dev server for containerized framework development.
  frontend:
    runtime: container
    image: {{ node_image }}
    mounts:
      - source://app:/app
    workdir: /app
    env:
      ANGEE_DJANGO_URL: http://django:8000
      ANGEE_UI_PORT: "{{ ui_port }}"
      ANGEE_OPERATOR_URL: "{{ operator_url }}"{% if ingress_domain_value == "localhost" %}{% else %}
      ANGEE_UI_ALLOWED_HOSTS: "{{ ingress_domain_value }}{% if ingress_aliases %},{{ ingress_aliases }}{% endif %}"{% endif %}{% if sentry_web_dsn %}
      VITE_SENTRY_DSN: "{{ sentry_web_dsn }}"
      VITE_SENTRY_ENVIRONMENT: "{{ effective_serve_mode }}"{% endif %}
    command:
      - sh
      - "-c"
      - >-
        corepack enable pnpm
        && exec pnpm --dir {{ web_path }} dev --host 0.0.0.0
    # The slim node image has neither wget nor curl, so probe with its own runtime.
    ready:
      cmd: ["node", "-e", "require('net').connect({{ ui_port }}, '127.0.0.1').on('connect', () => process.exit(0)).on('error', () => process.exit(1))"]
      interval: 5s
      timeout: 3s
      start_period: 30s
      retries: 180
    after: [django, codegen]{% if ingress_domain_value == "localhost" %}
    ports:
      - "${ports.ui}:{{ ui_port }}"{% else %}
    route: { port: {{ ui_port }}, path: /, auth: none }{% endif %}{% endif %}

  # The workspace dependency job also prepares the workshop and browser tools.
  storybook:
    runtime: container
    image: {{ node_image }}
    mounts:
      - source://app:/app
    workdir: /app
    env:
      STORYBOOK_PORT: "{{ storybook_port }}"
    command:
      - sh
      - "-c"
      - >-
        corepack enable pnpm;
        exec pnpm --filter @angee/storybook dev --no-open --host 0.0.0.0
    after: [deps]
    ports:
      - "${ports.storybook}:{{ storybook_port }}"

  # Remote Playwright browser server using the framework workspace's locked runner.
  playwright-server:
    runtime: container
    image: {{ playwright_image }}
    mounts:
      - source://app:/app
    workdir: /app
    command:
      - sh
      - "-c"
      - >-
        corepack enable pnpm;
        exec pnpm --filter @angee/e2e exec playwright run-server --host 0.0.0.0 --port 3100
    after: [frontend]
    route: { port: 3100, auth: forward }

  # Persistent headless Playwright MCP server behind forward-auth ingress.
  playwright-mcp:
    runtime: container
    image: {{ playwright_mcp_image }}
    mounts:
      - bind://./data/playwright:/data/profile
    # --allowed-hosts "*": requests arrive through the edge with the ingress domain as
    # Host; the MCP's own host check is a DNS-rebinding guard for unauthenticated local
    # servers, and THIS endpoint is route-only (never host-published) behind the
    # operator's forward-auth, so the edge bearer is the real gate.
    command: ["--headless", "--browser", "chromium", "--no-sandbox", "--host", "0.0.0.0", "--port", "8931", "--allowed-hosts", "*", "--user-data-dir", "/data/profile"]
    after: [frontend]
    route: { port: 8931, auth: forward }
{% endif %}{% endif %}{% if stack_flavor == "instance" or effective_serve_mode == "production" %}{% include "../_shared/static-frontend.yaml.jinja" %}{% endif %}
