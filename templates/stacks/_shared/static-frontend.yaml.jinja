
  # Browser-facing ingress. Caddy serves the built SPA and proxies only backend
  # endpoints over internal routes; SPA pages fall through to index.html.
  {% if stack_flavor == "framework" %}frontend{% else %}caddy{% endif %}:
    runtime: container
    image: {{ caddy_image }}
    mounts:
      - source://app:/srv/project
    command:
      - sh
      - "-c"
      - |-
{% if stack_flavor == "framework" and ingress_domain_value != "localhost" %}        until EDGE_IP=$$(getent hosts edge | awk 'NR==1 {print $$1}') && test -n "$$EDGE_IP"; do sleep 1; done
        EDGE_PROXY_CIDRS=$$(ip -4 route | awk '$$2 == "dev" && index($$1, "/") {printf "%s%s", sep, $$1; sep=" "}')
        test -n "$$EDGE_PROXY_CIDRS" || exit 1
{% endif %}{# On the same line as the script's next line: a block scalar that opens with a blank line is re-saved by the operator as an unparsable `|4-`. #}        cat >/etc/caddy/Caddyfile <<'CADDY'
{% if stack_flavor == "framework" and ingress_domain_value != "localhost" %}        {
          servers {
            trusted_proxies static EDGE_PROXY_CIDRS
            trusted_proxies_strict
          }
        }
{% endif %}
        :80 {
          encode zstd gzip
          root * /srv/project/{{ web_path }}/dist

          # Only a file the build names by its content is cached for good: Vite writes all it emits under assets/ as
          # <name>-<hash>.<ext>, the hash eight base-64 characters. The name must carry one, wherever the file sits:
          # an eight-character tail with no upper-case letter is taken for a word or a date, never for a hash, so a
          # hand-named file is not kept by mistake and the rare hash without one is merely not kept. Nothing else
          # is: a document is revalidated (below) and is never one of these files, the build's manifests and every
          # file under a stable name are left as they were, and a missing asset falls back to the app document, so
          # the file must exist.
          @hashed {
            path_regexp ^/assets/.+-[A-Za-z0-9_-]{8}(\.[A-Za-z0-9]+)+$
            not path_regexp -[a-z0-9_-]{8}(\.[A-Za-z0-9]+)+$
            not path *.html
            file
          }
          header @hashed Cache-Control "public, max-age=31536000, immutable"

          # Standalone pages the composer projects from addon declarations answer before Django and the app.
          # A glob: a stack whose composer emits no snippet still starts, and those paths stay Django's.
          import /srv/project/runtime/web/pages.cadd?

          @django path /graphql/* /acp/* /auth/csrf /auth/csrf/ /forms/* /storage/upload /storage/upload/* /storage/download /storage/download/* /admin/* /static/* /media/* /mcp /mcp/*
          handle @django {
            reverse_proxy django:8000 {
              header_up X-Forwarded-For {client_ip}
            }
          }

          @operator_graphql path /operator/graphql /operator/graphql/*
          handle @operator_graphql {
            uri strip_prefix /operator
            reverse_proxy operator:9000
          }

{% if effective_serve_mode == "development" %}          @operator_logs path_regexp operator_logs ^/operator/services/[^/]+/logs/stream$
          handle @operator_logs {
            uri strip_prefix /operator
            reverse_proxy operator:9000
          }{% endif %}

          handle {
            # Documents are revalidated, content-hashed assets are kept. The app document however it is reached (its
            # own name, a route or a missing file that falls back to it) and every other HTML document are stored
            # but checked by ETag before each use, so none outlives the hashed files it names. A document is never
            # one of the files kept above, and what Django answers keeps its own headers.
            @document {
              not {
                not path / *.html
                file
              }
            }
            header @document Cache-Control no-cache
            try_files {path} /index.html
            # A sidecar the build wrote beside a file answers a client that accepts it; with none, encode compresses.
            file_server {
              precompressed br zstd gzip
            }
          }
        }
        CADDY
{% if stack_flavor == "framework" and ingress_domain_value != "localhost" %}        sed -i "s|EDGE_PROXY_CIDRS|$$EDGE_PROXY_CIDRS|" /etc/caddy/Caddyfile
{% endif %}
        exec caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
    # Caddy normalizes the client IP before forwarding to Django. Public ingress
    # waits for the edge alias. The edge shares both default and ingress networks
    # with this frontend; trust their CIDRs so a restart cannot stale an IP.
    after: [frontend-build]
    ready:
      http: { port: 80, path: / }
{% if stack_flavor == "framework" and ingress_domain_value == "localhost" %}    ports:
      - "${ports.ui}:80"
{% endif %}{% if stack_flavor == "framework" and ingress_domain_value == "localhost" %}{% else %}{% if stack_flavor == "framework" %}    route: { port: 80, path: /, auth: none }
{% endif %}{% endif %}{% if stack_flavor == "instance" %}    ports:
      - "{{ ui_port }}:80"
{% endif %}
