{# No `license` field: a scaffolded addon belongs to whoever renders this template,
   and Angee is LGPL precisely so an addon on top can carry any license its author
   chooses. The framework's own web packages set `"license": "LGPL-3.0-or-later"`
   themselves; the scaffold does not assert a license for code it does not own. -#}
{
  "name": "{{ package_name }}",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@angee/app": "workspace:*",
    "@angee/ui": "workspace:*"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.16",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.10.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
