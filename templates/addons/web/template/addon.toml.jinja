# Angee addon manifest: every declaration fact lives here once; the AppConfig
# carries no copy. Every addon whose models, seeds or schema this one names is
# listed in depends_on.
[addon]
name = "{{ addon_name }}"
description = "{{ addon_title }}: {{ model_name | lower }} records owned by their creator."
keywords = ["{{ addon_id }}"]
depends_on = [
  "angee.base",
  "angee.iam",
  "angee.graphql",
  "angee.resources",
{%- if include_web %}
  "angee.web",
{%- endif %}
]

[resources]
demo = [
  { path = "resources/demo/010_{{ addon_id }}.{{ model_name | lower }}.yaml", depends_on = "iam:resources/demo/010_iam.user.yaml" },
]
